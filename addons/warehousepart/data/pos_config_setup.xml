<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
        ══════════════════════════════════════════════════════════════
        ร้านอาหลั่ย — POS & Website Warehouse Binding
        ══════════════════════════════════════════════════════════════
        ผูก:
          • POS Config หลัก → คลังหน้าร้าน (POS)
          • Website หลัก     → คลังออนไลน์ (WEB)

        ต้อง load หลัง warehouse_setup.xml เสมอ
        ══════════════════════════════════════════════════════════════
        -->

        <!-- ─── POS Config: ผูกกับคลังหน้าร้าน ─────────────────────────────── -->
        <!--
            point_of_sale.pos_config_main = POS Config ที่ติดตั้งมากับ Odoo โดย default
            warehouse_id → POS จะดึงสต็อกจากคลังหน้าร้าน (POS/Stock)
        -->
        <record id="point_of_sale.pos_config_main" model="pos.config">
            <field name="name">ร้านอาหลั่ย — หน้าร้าน</field>
            <field name="warehouse_id" ref="warehouse_pos"/>
        </record>

        <!-- ─── Website: ผูกกับคลังออนไลน์ ─────────────────────────────────── -->
        <!--
            website.default_website = Website หลักของ Odoo
            warehouse_id → eCommerce จะแสดงสต็อกจากคลังออนไลน์ (WEB/Stock)
        -->
        <record id="website.default_website" model="website">
            <field name="warehouse_id" ref="warehouse_web"/>
        </record>

    </data>
</odoo>
