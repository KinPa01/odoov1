<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Suppliers (Phase 2) -->
        <record id="supplier_001" model="res.partner">
            <field name="name">Supplier 001</field>
            <field name="supplier_rank">1</field>
        </record>
        <record id="supplier_002" model="res.partner">
            <field name="name">Supplier 002</field>
            <field name="supplier_rank">1</field>
        </record>
        <record id="supplier_003" model="res.partner">
            <field name="name">Supplier 003</field>
            <field name="supplier_rank">1</field>
        </record>

        <!-- Product Categories -->
        <record id="product_category_oil" model="product.category">
            <field name="name">น้ำมันเครื่อง</field>
        </record>
        <record id="product_category_brk" model="product.category">
            <field name="name">ระบบเบรก</field>
        </record>
        <record id="product_category_fil" model="product.category">
            <field name="name">กรอง</field>
        </record>
        <record id="product_category_bat" model="product.category">
            <field name="name">แบตเตอรี่</field>
        </record>
        <record id="product_category_sus" model="product.category">
            <field name="name">ช่วงล่าง</field>
        </record>

        <!-- POS Categories -->
        <record id="pos_category_oil" model="pos.category">
            <field name="name">น้ำมันเครื่อง</field>
        </record>
        <record id="pos_category_brk" model="pos.category">
            <field name="name">ระบบเบรก</field>
        </record>
        <record id="pos_category_fil" model="pos.category">
            <field name="name">กรอง</field>
        </record>
        <record id="pos_category_bat" model="pos.category">
            <field name="name">แบตเตอรี่</field>
        </record>
        <record id="pos_category_sus" model="pos.category">
            <field name="name">ช่วงล่าง</field>
        </record>

        <!-- Website eCommerce Categories -->
        <record id="web_category_oil" model="product.public.category">
            <field name="name">น้ำมันเครื่อง</field>
        </record>
        <record id="web_category_brk" model="product.public.category">
            <field name="name">ระบบเบรก</field>
        </record>
        <record id="web_category_fil" model="product.public.category">
            <field name="name">กรอง</field>
        </record>
        <record id="web_category_bat" model="product.public.category">
            <field name="name">แบตเตอรี่</field>
        </record>
        <record id="web_category_sus" model="product.public.category">
            <field name="name">ช่วงล่าง</field>
        </record>

        <!-- Locations (Phase 3) -->
        <record id="location_shelf_a1" model="stock.location">
            <field name="name">A1</field>
            <field name="location_id" ref="stock.stock_location_stock"/>
            <field name="usage">internal</field>
        </record>
        <record id="location_shelf_b1" model="stock.location">
            <field name="name">B1</field>
            <field name="location_id" ref="stock.stock_location_stock"/>
            <field name="usage">internal</field>
        </record>
        <record id="location_shelf_c1" model="stock.location">
            <field name="name">C1</field>
            <field name="location_id" ref="stock.stock_location_stock"/>
            <field name="usage">internal</field>
        </record>
        <record id="location_shelf_d1" model="stock.location">
            <field name="name">D1</field>
            <field name="location_id" ref="stock.stock_location_stock"/>
            <field name="usage">internal</field>
        </record>
        <record id="location_shelf_e1" model="stock.location">
            <field name="name">E1</field>
            <field name="location_id" ref="stock.stock_location_stock"/>
            <field name="usage">internal</field>
        </record>

        <!-- Products (Phase 1) -->
        <record id="product_oil_10w40" model="product.template">
            <field name="name">น้ำมันเครื่อง 10W-40</field>
            <field name="default_code">OIL-10W40-001</field>
            <field name="is_storable">True</field>
            <field name="barcode">885100000001</field>
            <field name="part_brand">Motul</field>
            <field name="car_model">Universal</field>
            <field name="shelf_location" ref="location_shelf_e1"/>
            <field name="categ_id" ref="product_category_oil"/>
            <field name="pos_categ_ids" eval="[(6, 0, [ref('pos_category_oil')])]"/>
            <field name="public_categ_ids" eval="[(6, 0, [ref('web_category_oil')])]"/>
            <field name="is_published">True</field>
            <field name="available_in_pos">True</field>
            <field name="list_price">690.00</field>
            <field name="standard_price">520.00</field>
            <field name="seller_ids" eval="[(0, 0, {'partner_id': ref('supplier_001'), 'min_qty': 1, 'price': 520.00})]"/>
        </record>

        <record id="product_brk_vios" model="product.template">
            <field name="name">ผ้าเบรกหน้า Vios</field>
            <field name="default_code">BRK-VIOS-001</field>
            <field name="is_storable">True</field>
            <field name="barcode">885100000002</field>
            <field name="part_brand">Bendix</field>
            <field name="car_model">Toyota Vios 2013-2018</field>
            <field name="shelf_location" ref="location_shelf_b1"/>
            <field name="categ_id" ref="product_category_brk"/>
            <field name="pos_categ_ids" eval="[(6, 0, [ref('pos_category_brk')])]"/>
            <field name="public_categ_ids" eval="[(6, 0, [ref('web_category_brk')])]"/>
            <field name="is_published">True</field>
            <field name="available_in_pos">True</field>
            <field name="list_price">950.00</field>
            <field name="standard_price">650.00</field>
            <field name="seller_ids" eval="[(0, 0, {'partner_id': ref('supplier_001'), 'min_qty': 1, 'price': 650.00})]"/>
        </record>

        <record id="product_fil_honda" model="product.template">
            <field name="name">กรองน้ำมัน Honda</field>
            <field name="default_code">FIL-HONDA-001</field>
            <field name="is_storable">True</field>
            <field name="barcode">885100000003</field>
            <field name="part_brand">Honda Genuine Parts</field>
            <field name="car_model">Honda City/Jazz/Civic</field>
            <field name="shelf_location" ref="location_shelf_a1"/>
            <field name="categ_id" ref="product_category_fil"/>
            <field name="pos_categ_ids" eval="[(6, 0, [ref('pos_category_fil')])]"/>
            <field name="public_categ_ids" eval="[(6, 0, [ref('web_category_fil')])]"/>
            <field name="is_published">True</field>
            <field name="available_in_pos">True</field>
            <field name="list_price">180.00</field>
            <field name="standard_price">90.00</field>
            <field name="seller_ids" eval="[(0, 0, {'partner_id': ref('supplier_002'), 'min_qty': 1, 'price': 90.00})]"/>
        </record>

        <record id="product_bat_ns60" model="product.template">
            <field name="name">แบตเตอรี่ NS60</field>
            <field name="default_code">BAT-NS60-001</field>
            <field name="barcode">885100000004</field>
            <field name="part_brand">FB Battery</field>
            <field name="car_model">Toyota Vios/Yaris, Honda City</field>
            <field name="shelf_location" ref="location_shelf_c1"/>
            <field name="categ_id" ref="product_category_bat"/>
            <field name="pos_categ_ids" eval="[(6, 0, [ref('pos_category_bat')])]"/>
            <field name="public_categ_ids" eval="[(6, 0, [ref('web_category_bat')])]"/>
            <field name="is_published">True</field>
            <field name="available_in_pos">True</field>
            <field name="list_price">2100.00</field>
            <field name="standard_price">1450.00</field>
            <field name="seller_ids" eval="[(0, 0, {'partner_id': ref('supplier_003'), 'min_qty': 1, 'price': 1450.00})]"/>
        </record>

        <record id="product_sus_vigo" model="product.template">
            <field name="name">ลูกหมากปีกนก Vigo</field>
            <field name="default_code">SUS-VIGO-001</field>
            <field name="barcode">885100000005</field>
            <field name="part_brand">555</field>
            <field name="car_model">Toyota Hilux Vigo 4WD</field>
            <field name="shelf_location" ref="location_shelf_d1"/>
            <field name="categ_id" ref="product_category_sus"/>
            <field name="pos_categ_ids" eval="[(6, 0, [ref('pos_category_sus')])]"/>
            <field name="public_categ_ids" eval="[(6, 0, [ref('web_category_sus')])]"/>
            <field name="is_published">True</field>
            <field name="available_in_pos">True</field>
            <field name="list_price">650.00</field>
            <field name="standard_price">380.00</field>
            <field name="seller_ids" eval="[(0, 0, {'partner_id': ref('supplier_001'), 'min_qty': 1, 'price': 380.00})]"/>
        </record>

        <!-- Reordering Rules (Orderpoints) Phase 3 -->
        <!-- In Odoo 15+ orderpoints MUST link to a supplier/vendor correctly if we want automatic purchase generation, which we set in seller_ids -->
        <record id="orderpoint_brk_vios" model="stock.warehouse.orderpoint">
            <field name="product_id" search="[('default_code', '=', 'BRK-VIOS-001')]"/>
            <field name="location_id" ref="stock.stock_location_stock"/>
            <field name="product_min_qty">3</field>
            <field name="product_max_qty">20</field>
        </record>

        <record id="orderpoint_fil_honda" model="stock.warehouse.orderpoint">
            <field name="product_id" search="[('default_code', '=', 'FIL-HONDA-001')]"/>
            <field name="location_id" ref="stock.stock_location_stock"/>
            <field name="product_min_qty">10</field>
            <field name="product_max_qty">50</field>
        </record>

        <record id="orderpoint_bat_ns60" model="stock.warehouse.orderpoint">
            <field name="product_id" search="[('default_code', '=', 'BAT-NS60-001')]"/>
            <field name="location_id" ref="stock.stock_location_stock"/>
            <field name="product_min_qty">2</field>
            <field name="product_max_qty">10</field>
        </record>

        <record id="orderpoint_oil_10w40" model="stock.warehouse.orderpoint">
            <field name="product_id" search="[('default_code', '=', 'OIL-10W40-001')]"/>
            <field name="location_id" ref="stock.stock_location_stock"/>
            <field name="product_min_qty">6</field>
            <field name="product_max_qty">36</field>
        </record>

        <!-- Pricelists (Phase 4) -->
        <record id="pricelist_retail" model="product.pricelist">
            <field name="name">Retail Price</field>
        </record>
        <record id="pricelist_garage" model="product.pricelist">
            <field name="name">Garage Price</field>
        </record>
        <record id="pricelist_member" model="product.pricelist">
            <field name="name">Member Price</field>
        </record>
        <record id="pricelist_online" model="product.pricelist">
            <field name="name">Online Price</field>
        </record>
    </data>
</odoo>
