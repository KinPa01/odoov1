<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- ─── POS Order Sequence ─────────────────────────────────── -->
        <record id="seq_spare_pos_order" model="ir.sequence">
            <field name="name">Spare POS Order</field>
            <field name="code">spare.pos.order</field>
            <field name="prefix">POS-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- ─── POS Session Sequence ──────────────────────────────── -->
        <record id="seq_spare_pos_session" model="ir.sequence">
            <field name="name">Spare POS Session</field>
            <field name="code">spare.pos.session</field>
            <field name="prefix">SESSION-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
