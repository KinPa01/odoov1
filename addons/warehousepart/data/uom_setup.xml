<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
        ══════════════════════════════════════════════════════════════
        ร้านอาหลั่ย — Units of Measure (UoM) Setup (Odoo 19 Compatible)
        ══════════════════════════════════════════════════════════════
        โครงสร้าง:
            ใช้ relative_factor เพื่อระบุอัตราส่วน
            ไม่ต้องใช้ product.packaging (เนื่องจาก Odoo 19 เปลี่ยนโมเดล)
            ใช้ uom_id (ขาย) และ uom_po_id (ซื้อ) โดยตรง
        ══════════════════════════════════════════════════════════════
        -->

        <!-- ─── หน่วยขาย/สต็อก ──────────────────────────────────────────────── -->

        <record id="uom_piece" model="uom.uom">
            <field name="name">ชิ้น</field>
            <field name="relative_factor">1.0</field>
            <field name="rounding">1.000</field>
        </record>

        <record id="uom_strand" model="uom.uom">
            <field name="name">เส้น</field>
            <field name="relative_factor">1.0</field>
            <field name="rounding">1.000</field>
        </record>

        <record id="uom_bottle" model="uom.uom">
            <field name="name">ขวด</field>
            <field name="relative_factor">1.0</field>
            <field name="rounding">1.000</field>
        </record>

        <!-- ─── หน่วยซื้อ (Purchase UoM) ตามขนาดบรรจุ ────────────────────────── -->

        <record id="uom_box_1" model="uom.uom">
            <field name="name">กล่อง (1 ชิ้น)</field>
            <field name="relative_uom_id" ref="uom_piece"/>
            <field name="relative_factor">1.0</field>
            <field name="rounding">1.000</field>
        </record>

        <record id="uom_box_4_piece" model="uom.uom">
            <field name="name">กล่อง (4 ชิ้น)</field>
            <field name="relative_uom_id" ref="uom_piece"/>
            <field name="relative_factor">4.0</field>
            <field name="rounding">1.000</field>
        </record>

        <record id="uom_box_4_strand" model="uom.uom">
            <field name="name">กล่อง (4 เส้น)</field>
            <field name="relative_uom_id" ref="uom_strand"/>
            <field name="relative_factor">4.0</field>
            <field name="rounding">1.000</field>
        </record>

        <record id="uom_crate_6" model="uom.uom">
            <field name="name">ลัง (6 ขวด)</field>
            <field name="relative_uom_id" ref="uom_bottle"/>
            <field name="relative_factor">6.0</field>
            <field name="rounding">1.000</field>
        </record>

        <record id="uom_box_10" model="uom.uom">
            <field name="name">กล่อง (10 ชิ้น)</field>
            <field name="relative_uom_id" ref="uom_piece"/>
            <field name="relative_factor">10.0</field>
            <field name="rounding">1.000</field>
        </record>

        <record id="uom_box_12" model="uom.uom">
            <field name="name">กล่อง (12 ชิ้น)</field>
            <field name="relative_uom_id" ref="uom_piece"/>
            <field name="relative_factor">12.0</field>
            <field name="rounding">1.000</field>
        </record>

        <record id="uom_set_4" model="uom.uom">
            <field name="name">ชุด (4 ชิ้น)</field>
            <field name="relative_uom_id" ref="uom_piece"/>
            <field name="relative_factor">4.0</field>
            <field name="rounding">1.000</field>
        </record>

        <!-- ══════ กำหนด UoM ต่อสินค้า ══════ -->

        <!-- น้ำมันเครื่อง 10W-40: ขาย=ขวด | ซื้อ=ลัง (6 ขวด) -->
        <record id="product_oil_10w40" model="product.template">
            <field name="uom_id" ref="uom_bottle"/>
            <field name="uom_po_id" ref="uom_crate_6"/>
        </record>

        <!-- ผ้าเบรกหน้า Vios: ขาย=ชิ้น | ซื้อ=ชุด (4 ชิ้น) -->
        <record id="product_brk_vios" model="product.template">
            <field name="uom_id" ref="uom_piece"/>
            <field name="uom_po_id" ref="uom_set_4"/>
        </record>

        <!-- กรองน้ำมัน Honda: ขาย=ชิ้น | ซื้อ=กล่อง (12 ชิ้น) -->
        <record id="product_fil_honda" model="product.template">
            <field name="uom_id" ref="uom_piece"/>
            <field name="uom_po_id" ref="uom_box_12"/>
        </record>

        <!-- แบตเตอรี่ NS60: ขาย=ชิ้น | ซื้อ=กล่อง (1 ชิ้น) -->
        <record id="product_bat_ns60" model="product.template">
            <field name="uom_id" ref="uom_piece"/>
            <field name="uom_po_id" ref="uom_box_1"/>
        </record>

        <!-- ลูกหมากปีกนก Vigo: ขาย=ชิ้น | ซื้อ=กล่อง (1 ชิ้น) -->
        <record id="product_sus_vigo" model="product.template">
            <field name="uom_id" ref="uom_piece"/>
            <field name="uom_po_id" ref="uom_box_1"/>
        </record>

        <!-- ยางนอก IRC: ขาย=เส้น | ซื้อ=กล่อง (4 เส้น) -->
        <record id="product_tire_irc_7090" model="product.template">
            <field name="uom_id" ref="uom_strand"/>
            <field name="uom_po_id" ref="uom_box_4_strand"/>
        </record>

        <!-- ยางนอก Michelin City Grip: ขาย=เส้น | ซื้อ=กล่อง (4 เส้น) -->
        <record id="product_tire_mic_9090" model="product.template">
            <field name="uom_id" ref="uom_strand"/>
            <field name="uom_po_id" ref="uom_box_4_strand"/>
        </record>

        <!-- ผ้าเบรกหน้า NMAX: ขาย=ชิ้น | ซื้อ=ชุด (4 ชิ้น) -->
        <record id="product_brk_nmax" model="product.template">
            <field name="uom_id" ref="uom_piece"/>
            <field name="uom_po_id" ref="uom_set_4"/>
        </record>

        <!-- ผ้าเบรกหลัง PCX: ขาย=ชิ้น | ซื้อ=ชุด (4 ชิ้น) -->
        <record id="product_brk_pcx" model="product.template">
            <field name="uom_id" ref="uom_piece"/>
            <field name="uom_po_id" ref="uom_set_4"/>
        </record>

        <!-- แบต YUASA: ขาย=ชิ้น | ซื้อ=กล่อง (1 ชิ้น) -->
        <record id="product_bat_yuasa" model="product.template">
            <field name="uom_id" ref="uom_piece"/>
            <field name="uom_po_id" ref="uom_box_1"/>
        </record>

        <!-- หัวเทียน NGK: ขาย=ชิ้น | ซื้อ=กล่อง (10 ชิ้น) -->
        <record id="product_spk_ngk" model="product.template">
            <field name="uom_id" ref="uom_piece"/>
            <field name="uom_po_id" ref="uom_box_10"/>
        </record>

        <!-- สายพาน Honda PCX: ขาย=ชิ้น | ซื้อ=กล่อง (1 ชิ้น) -->
        <record id="product_belt_pcx" model="product.template">
            <field name="uom_id" ref="uom_piece"/>
            <field name="uom_po_id" ref="uom_box_1"/>
        </record>

        <!-- สายพาน Yamaha Aerox: ขาย=ชิ้น | ซื้อ=กล่อง (1 ชิ้น) -->
        <record id="product_belt_aerox" model="product.template">
            <field name="uom_id" ref="uom_piece"/>
            <field name="uom_po_id" ref="uom_box_1"/>
        </record>

        <!-- น้ำมันเครื่อง Castrol: ขาย=ขวด | ซื้อ=ลัง (6 ขวด) -->
        <record id="product_oil_castrol" model="product.template">
            <field name="uom_id" ref="uom_bottle"/>
            <field name="uom_po_id" ref="uom_crate_6"/>
        </record>

        <!-- น้ำมันเครื่อง Shell: ขาย=ขวด | ซื้อ=ลัง (6 ขวด) -->
        <record id="product_oil_shell" model="product.template">
            <field name="uom_id" ref="uom_bottle"/>
            <field name="uom_po_id" ref="uom_crate_6"/>
        </record>

        <!-- น้ำมันเครื่อง Mobil 1: ขาย=ขวด | ซื้อ=ลัง (6 ขวด) -->
        <record id="product_oil_mobil" model="product.template">
            <field name="uom_id" ref="uom_bottle"/>
            <field name="uom_po_id" ref="uom_crate_6"/>
        </record>

        <!-- น้ำมันเครื่อง Valvoline: ขาย=ขวด | ซื้อ=ลัง (6 ขวด) -->
        <record id="product_oil_valvoline" model="product.template">
            <field name="uom_id" ref="uom_bottle"/>
            <field name="uom_po_id" ref="uom_crate_6"/>
        </record>

        <!-- น้ำมันเครื่อง PTT: ขาย=ขวด | ซื้อ=ลัง (6 ขวด) -->
        <record id="product_oil_ptt" model="product.template">
            <field name="uom_id" ref="uom_bottle"/>
            <field name="uom_po_id" ref="uom_crate_6"/>
        </record>

        <!-- ยางรถยนต์ Bridgestone: ขาย=เส้น | ซื้อ=กล่อง (4 เส้น) -->
        <record id="product_tire_bridge" model="product.template">
            <field name="uom_id" ref="uom_strand"/>
            <field name="uom_po_id" ref="uom_box_4_strand"/>
        </record>

        <!-- ยางรถยนต์ Michelin Primacy 4: ขาย=เส้น | ซื้อ=กล่อง (4 เส้น) -->
        <record id="product_tire_mic_car" model="product.template">
            <field name="uom_id" ref="uom_strand"/>
            <field name="uom_po_id" ref="uom_box_4_strand"/>
        </record>

        <!-- กรองอากาศ Wave: ขาย=ชิ้น | ซื้อ=กล่อง (12 ชิ้น) -->
        <record id="product_fil_wave" model="product.template">
            <field name="uom_id" ref="uom_piece"/>
            <field name="uom_po_id" ref="uom_box_12"/>
        </record>

        <!-- กรองอากาศ XMAX: ขาย=ชิ้น | ซื้อ=กล่อง (12 ชิ้น) -->
        <record id="product_fil_xmax" model="product.template">
            <field name="uom_id" ref="uom_piece"/>
            <field name="uom_po_id" ref="uom_box_12"/>
        </record>

        <!-- โซ่สเตอร์ DID: ขาย=ชิ้น | ซื้อ=กล่อง (1 ชิ้น) -->
        <record id="product_chain_did_428" model="product.template">
            <field name="uom_id" ref="uom_piece"/>
            <field name="uom_po_id" ref="uom_box_1"/>
        </record>

        <!-- หลอดไฟ Osram: ขาย=ชิ้น | ซื้อ=กล่อง (10 ชิ้น) -->
        <record id="product_led_osram" model="product.template">
            <field name="uom_id" ref="uom_piece"/>
            <field name="uom_po_id" ref="uom_box_10"/>
        </record>

    </data>
</odoo>
