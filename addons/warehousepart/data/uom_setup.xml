<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
        ══════════════════════════════════════════════════════════════
        ร้านอาหลั่ย — Units of Measure (UoM) Setup
        ══════════════════════════════════════════════════════════════
        โครงสร้าง:

            หน่วยนับสินค้า (สำหรับขาย POS / เว็บ)
            └── ชิ้น  [base]

            หน่วยซื้อ (สำหรับรับของจากซัพพลายเออร์)
            ├── กล่อง  → ใช้กับกรอง, ผ้าเบรก, หัวเทียน, แบต, ยาง, สายพาน
            └── ลัง   → ใช้กับน้ำมันเครื่อง

            การแปลงหน่วย (ตั้งต่อสินค้า):
            • กรองน้ำมัน   : 1 กล่อง = 12 ชิ้น
            • ผ้าเบรก      : 1 กล่อง = 4  ชิ้น  (1 ชุด)
            • แบตเตอรี่    : 1 กล่อง = 1  ชิ้น
            • ยางนอก       : 1 กล่อง = 4  เส้น
            • น้ำมันเครื่อง: 1 ลัง   = 6  ขวด
            • หัวเทียน     : 1 กล่อง = 10 ชิ้น
            • สายพาน       : 1 กล่อง = 1  ชิ้น

        noupdate="1" → ไม่เขียนทับเมื่อ upgrade
        ══════════════════════════════════════════════════════════════
        -->

        <!-- ─── UoM Category: หน่วยอะไหล่ ──────────────────────────────────── -->
        <record id="uom_category_spare" model="uom.category">
            <field name="name">หน่วยอะไหล่</field>
        </record>

        <!-- ─── UoM: ชิ้น (Base Unit) ───────────────────────────────────────── -->
        <!--
            เป็นหน่วยฐาน (ratio=1.0)
            ใช้สำหรับ: ขายใน POS, เว็บ, นับสต็อกภายใน
        -->
        <record id="uom_piece" model="uom.uom">
            <field name="name">ชิ้น</field>
            <field name="category_id" ref="uom_category_spare"/>
            <field name="factor">1.0</field>
            <field name="uom_type">reference</field>
            <field name="rounding">1.000</field>
        </record>

        <!-- ─── UoM: เส้น (สำหรับยาง) ──────────────────────────────────────── -->
        <record id="uom_strand" model="uom.uom">
            <field name="name">เส้น</field>
            <field name="category_id" ref="uom_category_spare"/>
            <field name="factor">1.0</field>
            <field name="uom_type">bigger</field>
            <field name="rounding">1.000</field>
        </record>

        <!-- ─── UoM: ขวด (สำหรับน้ำมันเครื่อง) ─────────────────────────────── -->
        <record id="uom_bottle" model="uom.uom">
            <field name="name">ขวด</field>
            <field name="category_id" ref="uom_category_spare"/>
            <field name="factor">1.0</field>
            <field name="uom_type">bigger</field>
            <field name="rounding">1.000</field>
        </record>

        <!-- ─── UoM: กล่อง (Purchase UoM — ratio ตั้งต่อสินค้า) ──────────── -->
        <!--
            กล่องกลาง: ใช้ร่วมกันได้ทุกประเภทสินค้า
            ratio (factor_inv) ตั้งบนระดับสินค้าแทน
            ตัวอย่าง: กรองน้ำมัน → factor=12 หมายถึง 1 กล่อง = 12 ชิ้น
        -->
        <record id="uom_box" model="uom.uom">
            <field name="name">กล่อง</field>
            <field name="category_id" ref="uom_category_spare"/>
            <field name="factor">1.0</field>
            <field name="uom_type">bigger</field>
            <field name="rounding">1.000</field>
        </record>

        <!-- ─── UoM: ลัง (Purchase UoM สำหรับน้ำมันเครื่อง) ────────────────── -->
        <record id="uom_crate" model="uom.uom">
            <field name="name">ลัง</field>
            <field name="category_id" ref="uom_category_spare"/>
            <field name="factor">1.0</field>
            <field name="uom_type">bigger</field>
            <field name="rounding">1.000</field>
        </record>

        <!-- ─── UoM: ชุด (Purchase UoM สำหรับผ้าเบรก) ──────────────────────── -->
        <record id="uom_set" model="uom.uom">
            <field name="name">ชุด</field>
            <field name="category_id" ref="uom_category_spare"/>
            <field name="factor">1.0</field>
            <field name="uom_type">bigger</field>
            <field name="rounding">1.000</field>
        </record>

