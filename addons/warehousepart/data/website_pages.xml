<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Shipping Policy Page -->
    <record id="page_shipping_policy" model="website.page">
        <field name="name">นโยบายการจัดส่งสินค้า</field>
        <field name="url">/shipping-policy</field>
        <field name="type">qweb</field>
        <field name="key">warehousepart.shipping_policy</field>
        <field name="is_published">True</field>
        <field name="arch" type="xml">
            <t name="นโยบายการจัดส่ง" t-name="warehousepart.shipping_policy">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty" style="font-family: 'Inter', 'Roboto', sans-serif;">
                        <section class="pt64 pb64" style="background-color: #fdfdfd; border-bottom: 1px solid #f3f4f6;">
                            <div class="container">
                                <div class="row justify-content-center">
                                    <div class="col-lg-8 bg-white p-5 rounded" style="border: 1px solid #f3f4f6;">
                                        <h1 class="text-center mb-4" style="color: #111827; font-weight: 700; letter-spacing: -0.5px;">นโยบายการจัดส่งสินค้า</h1>
                                        <div style="width: 40px; height: 3px; background-color: #e5e7eb; margin: 0 auto 30px auto;"></div>
                                        <h4 class="mt-4" style="color: #111827; font-weight: 600; font-size: 1.1rem;">1. ระยะเวลาการจัดส่ง</h4>
                                        <p style="color: #4b5563; line-height: 1.6;">เราจัดส่งอะไหล่ด้วยความรวดเร็ว โดยตัดรอบทุกๆ 14:00 น. ของทุกวันทำการ (จันทร์ - เสาร์) สินค้าจะถูกจัดส่งภายใน 1-3 วันทำการขึ้นอยู่กับพื้นที่ปลายทาง</p>
                                        
                                        <h4 class="mt-5" style="color: #111827; font-weight: 600; font-size: 1.1rem;">2. ผู้ให้บริการขนส่ง</h4>
                                        <p style="color: #4b5563; line-height: 1.6;">ร้านอาหลั่ยใช้บริการขนส่งที่ได้มาตรฐาน เช่น Kerry Express, Flash Express เพื่อให้คุณมั่นใจว่าสินค้าจะถึงมืออย่างปลอดภัย</p>
                                        
                                        <h4 class="mt-5" style="color: #111827; font-weight: 600; font-size: 1.1rem;">3. การตรวจสอบสถานะ</h4>
                                        <p style="color: #4b5563; line-height: 1.6;">เมื่อสินค้าถูกจัดส่งแล้ว คุณจะได้รับหมายเลขติดตาม (Tracking Number) ทางอีเมล และสามารถตรวจสอบได้ที่เมนู "ประวัติการสั่งซื้อ" ในบัญชีของคุณ</p>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- Return Policy Page -->
    <record id="page_return_policy" model="website.page">
        <field name="name">นโยบายการคืนสินค้า</field>
        <field name="url">/return-policy</field>
        <field name="type">qweb</field>
        <field name="key">warehousepart.return_policy</field>
        <field name="is_published">True</field>
        <field name="arch" type="xml">
            <t name="นโยบายการคืนสินค้า" t-name="warehousepart.return_policy">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty" style="font-family: 'Inter', 'Roboto', sans-serif;">
                        <section class="pt64 pb64" style="background-color: #fdfdfd; border-bottom: 1px solid #f3f4f6;">
                            <div class="container">
                                <div class="row justify-content-center">
                                    <div class="col-lg-8 bg-white p-5 rounded" style="border: 1px solid #f3f4f6;">
                                        <h1 class="text-center mb-4" style="color: #111827; font-weight: 700; letter-spacing: -0.5px;">นโยบายการคืนสินค้า</h1>
                                        <div style="width: 40px; height: 3px; background-color: #e5e7eb; margin: 0 auto 30px auto;"></div>
                                        <h4 class="mt-4" style="color: #111827; font-weight: 600; font-size: 1.1rem;">1. เงื่อนไขการรับคืนสินค้า</h4>
                                        <p style="color: #4b5563; line-height: 1.6;">ร้านอาหลั่ยยินดีรับคืนสินค้าหรือเปลี่ยนสินค้าใหม่ภายใน 7 วัน นับจากวันที่ได้รับสินค้า เฉพาะกรณีที่สินค้าชำรุดจากการขนส่ง หรือทางร้านจัดส่งอะไหล่ผิดรุ่นเท่านั้น</p>
                                        
                                        <h4 class="mt-5" style="color: #111827; font-weight: 600; font-size: 1.1rem;">2. สภาพสินค้าที่รับคืน</h4>
                                        <p style="color: #4b5563; line-height: 1.6;">สินค้าจะต้องอยู่ในสภาพเดิม ไม่ผ่านการใช้งาน บรรจุภัณฑ์ต้องสมบูรณ์ และห้ามแกะซีล (สำหรับอะไหล่ระบบไฟฟ้า)</p>
                                        
                                        <h4 class="mt-5" style="color: #111827; font-weight: 600; font-size: 1.1rem;">3. ขั้นตอนการแจ้งส่งคืน</h4>
                                        <p style="color: #4b5563; line-height: 1.6;">กรุณาติดต่อทีมงานของเราผ่านเมนู "ติดต่อเรา" หรือโทรศัพท์ พร้อมแจ้งหมายเลขคำสั่งซื้อและแนบรูปถ่ายสินค้าที่มีปัญหา ทีมงานจะติดต่อกลับภายใน 24 ชั่วโมงเพื่อแจ้งขั้นตอนถัดไป</p>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>
</odoo>
