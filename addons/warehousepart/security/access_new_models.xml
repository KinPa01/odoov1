        <record id="access_pos_sync_wizard_accountant" model="ir.model.access">
            <field name="name">store.pos.sync.wizard.accountant</field>
            <field name="model_id" ref="model_store_pos_sync_wizard"/>
            <field name="group_id" ref="warehousepart.group_spare_accountant"/>
            <field name="perm_read"   eval="1"/>
            <field name="perm_write"  eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- ─── store.payslip.import.wizard ─────────────────────────────────── -->
        <record id="access_payslip_import_wizard_owner" model="ir.model.access">
            <field name="name">store.payslip.import.wizard.owner</field>
            <field name="model_id" ref="model_store_payslip_import_wizard"/>
