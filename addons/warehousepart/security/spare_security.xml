<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ══════════════════════════════════════════════════════════════════
             RBAC — Security Groups (ร้านอาหลั่ย)
             ══════════════════════════════════════════════════════════════════
             4 บทบาทหลัก:
               1. group_spare_cashier      — พนักงานขายหน้าร้าน (POS เท่านั้น)
               2. group_spare_inventory    — พนักงานคลัง (จัดส่ง + โอนย้ายสินค้า)
               3. group_spare_accountant   — พนักงานบัญชี (เงินเดือน + การเงินบริษัท)
               4. group_spare_owner        — เจ้าของร้าน (ทุกอย่าง)

             implied Odoo groups:
               cashier     → point_of_sale.group_pos_user
               inventory   → stock.group_stock_user
               accountant  → account.group_account_user
               owner       → account.group_account_manager
                           + stock.group_stock_manager
                           + point_of_sale.group_pos_manager
                           + purchase.group_purchase_manager
                           + base.group_erp_manager (Settings)
        ══════════════════════════════════════════════════════════════════ -->

        <!-- ─── 1. พนักงานหน้าร้าน (ดูชั้นวาง read-only) ─────────────── -->
        <record id="group_spare_front_staff" model="res.groups">
            <field name="name">พนักงานหน้าร้าน (Front Staff)</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">ดูชั้นวางสินค้าและสต็อกคลังหน้าร้านได้ — ห้ามแก้ไขข้อมูล</field>
        </record>

        <!-- ─── 2. พนักงานขายหน้าร้าน / แคชเชียร์ (POS เท่านั้น) ────── -->
        <record id="group_spare_cashier" model="res.groups">
            <field name="name">พนักงานขายหน้าร้าน / แคชเชียร์ (Cashier)</field>
            <field name="implied_ids" eval="[
                (4, ref('base.group_user')),
                (4, ref('point_of_sale.group_pos_user')),
            ]"/>
            <field name="comment">เข้าถึงได้เฉพาะ POS — ไม่สามารถดูคลัง, บัญชี หรือข้อมูลสินค้าในแบ็กเอนด์ได้</field>
        </record>

        <!-- ─── 3. พนักงานคลังสินค้า (จัดส่ง + โอนย้ายสินค้า) ────────── -->
        <record id="group_spare_inventory" model="res.groups">
            <field name="name">พนักงานคลัง (Inventory Staff)</field>
            <field name="implied_ids" eval="[
                (4, ref('base.group_user')),
                (4, ref('stock.group_stock_user')),
            ]"/>
            <field name="comment">จัดการการจัดส่งสินค้าและโอนย้ายสินค้าในคลัง — ไม่สามารถดูบัญชีหรือ POS ได้</field>
        </record>

        <!-- ─── 4. พนักงานบัญชี (เงินเดือน + การเงินบริษัท) ──────────── -->
        <record id="group_spare_accountant" model="res.groups">
            <field name="name">พนักงานบัญชี (Accountant)</field>
            <field name="implied_ids" eval="[
                (4, ref('base.group_user')),
                (4, ref('account.group_account_manager')),
            ]"/>
            <field name="comment">ดูและจัดการรายรับ/รายจ่าย + ข้อมูลเงินเดือนพนักงาน — ไม่สามารถดูคลังหรือ POS ได้</field>
        </record>

        <!-- ─── 5. ผู้จัดการร้าน (Manager) — legacy role ──────────────── -->
        <record id="group_spare_manager" model="res.groups">
            <field name="name">ผู้จัดการร้าน (Manager)</field>
            <field name="implied_ids" eval="[
                (4, ref('group_spare_cashier')),
                (4, ref('group_spare_inventory')),
                (4, ref('purchase.group_purchase_user')),
            ]"/>
            <field name="comment">จัดการสินค้า คลัง POS และการจัดซื้อ</field>
        </record>

        <!-- ─── 6. เจ้าของร้าน (Owner) — สิทธิ์สูงสุด ─────────────────── -->
        <record id="group_spare_owner" model="res.groups">
            <field name="name">เจ้าของร้าน (Owner)</field>
            <field name="implied_ids" eval="[
                (4, ref('group_spare_front_staff')),
                (4, ref('group_spare_cashier')),
                (4, ref('group_spare_inventory')),
                (4, ref('group_spare_accountant')),
                (4, ref('group_spare_manager')),
                (4, ref('account.group_account_manager')),
                (4, ref('stock.group_stock_manager')),
                (4, ref('point_of_sale.group_pos_manager')),
                (4, ref('purchase.group_purchase_manager')),
                (4, ref('base.group_erp_manager')),
                (4, ref('base.group_system')),
                (4, ref('hr.group_hr_manager')),
            ]"/>
            <field name="comment">เข้าถึงทุกเมนูและฟีเจอร์ทั้งหมดของระบบ — ดูสินค้า, การเงิน, คลัง, POS ได้ทุกอย่าง</field>
        </record>

        <!-- ─── Legacy groups — ยังถูก reference โดย ir.rule ใน DB อย่าลบ ─ -->
        <record id="group_warehousepart_accountant" model="res.groups">
            <field name="name">Accountant / นักบัญชี (Legacy)</field>
            <field name="implied_ids" eval="[(4, ref('group_spare_accountant'))]"/>
        </record>

        <record id="group_warehousepart_admin" model="res.groups">
            <field name="name">Admin / เจ้าของร้าน (Legacy)</field>
            <field name="implied_ids" eval="[(4, ref('group_spare_owner'))]"/>
        </record>

        <record id="group_warehousepart_user" model="res.groups">
            <field name="name">Warehousepart / User (Legacy)</field>
            <field name="implied_ids" eval="[(4, ref('group_spare_front_staff'))]"/>
        </record>

        <record id="group_warehousepart_manager" model="res.groups">
            <field name="name">Warehousepart / Manager (Legacy)</field>
            <field name="implied_ids" eval="[(4, ref('group_spare_manager'))]"/>
        </record>

        <record id="group_warehousepart_cashier" model="res.groups">
            <field name="name">Warehousepart / Cashier (Legacy)</field>
            <field name="implied_ids" eval="[(4, ref('group_spare_cashier'))]"/>
        </record>

        <record id="group_warehousepart_stock" model="res.groups">
            <field name="name">Warehousepart / Stock (Legacy)</field>
            <field name="implied_ids" eval="[(4, ref('group_spare_inventory'))]"/>
        </record>

        <!-- ══════════════════════════════════════════════════════════════════
             Record Rules — hr.attendance.custom
             ══════════════════════════════════════════════════════════════════
             กฎ:
               • พนักงานทั่วไป (cashier, inventory, front_staff)
                 → เห็นได้เฉพาะ attendance บันทึกของตัวเอง
               • เจ้าของร้าน + บัญชี (owner, accountant, admin)
                 → เห็น attendance ของทุกคน
        ══════════════════════════════════════════════════════════════════ -->

        <!-- Rule 1: พนักงานทั่วไป — เห็นแค่ของตัวเอง -->
        <record id="rule_attendance_own_only" model="ir.rule">
            <field name="name">บันทึกเวลางาน — เห็นเฉพาะของตัวเอง (พนักงาน)</field>
            <field name="model_id" ref="model_hr_attendance_custom"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[
                (4, ref('warehousepart.group_spare_cashier')),
                (4, ref('warehousepart.group_spare_inventory')),
                (4, ref('warehousepart.group_spare_front_staff')),
            ]"/>
            <field name="perm_read"   eval="True"/>
            <field name="perm_write"  eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Rule 2: เจ้าของ + บัญชี — เห็นทุกคน (global read) -->
        <record id="rule_attendance_all_access" model="ir.rule">
            <field name="name">บันทึกเวลางาน — เห็นทุกคน (Owner/Accountant)</field>
            <field name="model_id" ref="model_hr_attendance_custom"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[
                (4, ref('warehousepart.group_spare_owner')),
                (4, ref('warehousepart.group_spare_accountant')),
                (4, ref('warehousepart.group_spare_manager')),
            ]"/>
            <field name="perm_read"   eval="True"/>
            <field name="perm_write"  eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
