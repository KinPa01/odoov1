<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- สิทธิ์: พนักงานขาย (Cashier) -->
        <record id="group_spare_cashier" model="res.groups">
            <field name="name">พนักงานขาย / แคชเชียร์ (Cashier)</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">มีสิทธิ์เฉพาะดูข้อมูลแคตตาล็อกอะไหล่ และเข้าใช้งาน POS ได้</field>
        </record>

        <!-- สิทธิ์: พนักงานคลังสินค้า (Inventory) -->
        <record id="group_spare_inventory" model="res.groups">
            <field name="name">พนักงานคลังสินค้า (Inventory Staff)</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">มีสิทธิ์จัดการคลังสินค้าและการจัดส่ง</field>
        </record>

        <!-- สิทธิ์: ผู้จัดการร้าน (Manager) -->
        <record id="group_spare_manager" model="res.groups">
            <field name="name">ผู้จัดการร้าน (Manager)</field>
            <field name="implied_ids" eval="[(4, ref('group_spare_cashier')), (4, ref('group_spare_inventory'))]"/>
            <field name="comment">มีสิทธิ์เข้าถึงทุกเมนู รวมถึงการจัดซื้อและคลังสินค้า</field>
        </record>

        <!-- Legacy groups — ยังถูก reference โดย ir.rule ใน DB อย่าลบ -->
        <record id="group_warehousepart_accountant" model="res.groups">
            <field name="name">Accountant / นักบัญชี</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_warehousepart_admin" model="res.groups">
            <field name="name">Admin / เจ้าของร้าน</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_warehousepart_user" model="res.groups">
            <field name="name">Warehousepart / User</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_warehousepart_manager" model="res.groups">
            <field name="name">Warehousepart / Manager</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_warehousepart_cashier" model="res.groups">
            <field name="name">Warehousepart / Cashier</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_warehousepart_stock" model="res.groups">
            <field name="name">Warehousepart / Stock</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>
</odoo>
