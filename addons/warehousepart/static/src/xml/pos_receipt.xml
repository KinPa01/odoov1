<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- Override POS OrderReceipt to add Ran Ahlai Branding -->
    <!-- Odoo 19: structure uses ReceiptHeader, pos-receipt-amount, before-footer, after-footer -->
    <t t-name="warehousepart.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension" owl="1">

        <!-- Inject Ran Ahlai header BEFORE the standard ReceiptHeader (at the very top) -->
        <xpath expr="//ReceiptHeader" position="before">
            <div class="ran-ahlai-pos-header">
                <h2>ร้านอาหลั่ย</h2>
                <div class="ran-ahlai-pos-slogan">อะไหล่แท้ ราคาดี ส่งทั่วไทย</div>
                <div class="ran-ahlai-pos-info">
                    <div>เลขประจำตัวผู้เสียภาษี: <t t-esc="order.company.vat || '0105561000000'"/></div>
                    <div>โทร: <t t-esc="order.company.phone || '02-123-4567'"/></div>
                </div>
                <div class="receipt-divider"></div>
            </div>
        </xpath>

        <!-- Inject thank-you footer INSIDE before-footer div (safe hook in Odoo 19) -->
        <xpath expr="//div[hasclass('before-footer')]" position="inside">
            <div class="ran-ahlai-pos-footer">
                <div class="footer-thankyou">ขอบคุณที่ใช้บริการร้านอาหลั่ย</div>
                <div class="footer-sub">สินค้าทุกชิ้นรับประกันคุณภาพตามมาตรฐานผู้ผลิต</div>
                <div class="footer-social">FB: ร้านอาหลั่ย | Line: @RanAhlai</div>
            </div>
        </xpath>

    </t>
</templates>
