<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ══════════════════════════════════════════════════
         เมนูหลัก — ร้านอาหลั่ย (Hub สำหรับอะไหล่รถยนต์)
    ══════════════════════════════════════════════════ -->
    <menuitem id="menu_warehousepart_root"
              name="ร้านอาหลั่ย"
              sequence="10"
              web_icon="warehousepart,static/description/icon.png"/>

    <!-- ══ สินค้าอะไหล่ ══ -->
    <menuitem id="menu_spare_parts_main"
              name="📦 ฐานข้อมูลอะไหล่"
              parent="menu_warehousepart_root"
              sequence="10"/>

    <menuitem id="menu_spare_part_list"
              name="แคตตาล็อกอะไหล่"
              parent="menu_spare_parts_main"
              action="action_spare_product_template"
              sequence="10"/>

    <menuitem id="menu_spare_part_category"
              name="หมวดหมู่อะไหล่ (POS)"
              parent="menu_spare_parts_main"
              action="point_of_sale.product_pos_category_action"
              sequence="20"/>

    <!-- ══ คลังสินค้า (ทางลัดไป Inventory ของ Odoo) ══ -->
    <menuitem id="menu_spare_inventory_shortcut"
              name="🏗️ คลังสินค้าและการจัดส่ง"
              parent="menu_warehousepart_root"
              action="stock.stock_picking_type_action"
              sequence="20"/>

    <!-- ══ POS & การขาย (ทางลัดไป POS ของ Odoo) ══ -->
    <menuitem id="menu_spare_pos_shortcut"
              name="🖥️ ระบบขายหน้าร้าน (POS)"
              parent="menu_warehousepart_root"
              action="point_of_sale.action_pos_config_kanban"
              sequence="30"/>
              
    <!-- ══ การจัดซื้อ (ทางลัดไป Purchase ของ Odoo) ══ -->
    <menuitem id="menu_spare_purchase_shortcut"
              name="🛒 ระบบสั่งซื้อ (Purchase)"
              parent="menu_warehousepart_root"
              action="purchase.purchase_rfq"
              sequence="40"/>

    <!-- ══ ข้อมูลผู้ติดต่อ / Supplier ══ -->
    <menuitem id="menu_spare_partner_shortcut"
              name="🤝 ลูกค้า &amp; ซัพพลายเออร์"
              parent="menu_warehousepart_root"
              action="base.action_partner_form"
              sequence="50"/>
</odoo>
