<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
    ══════════════════════════════════════════════════════════════════════════════
     ร้านอาหลั่ย — Menu Structure (Odoo 19)

     แบ่งเป็น 2 ส่วน:
     ─────────────────────────────────────────────────────────────────────────
     [A] แอปหลัก "ร้านอาหลั่ย" — คลัง / POS / เวลาทำงาน
         seq 10  🏗️ คลัง / รับ-ส่งสินค้า   ← พนักงานคลัง
         seq 15  📦 สินค้าและคลัง
         seq 20  🛒 สั่งซื้อ
         seq 25  🖥️ POS หน้าร้าน
         seq 30  ⏱️ เวลาทำงาน
         seq 40  🤝 ผู้ติดต่อ
         seq 50  🌐 เว็บไซต์

     [B] ออกใบแจ้งหนี้ (account.menu_finance) — บัญชีร้านอาหลั่ย
         seq 90  ─── บัญชีร้านอาหลั่ย ───   (divider group)
         seq 91  📊 รายรับ-รายจ่ายทั้งหมด
         seq 92  💚 รายรับ (Income)
         seq 93  🔴 รายจ่าย (Expense)
         seq 94  📅 สรุปรายรับ-รายจ่ายประจำวัน
         seq 95  💸 จ่ายเงินเดือนพนักงาน
         seq 96  📈 รายได้สุทธิสินค้า
         seq 97  👥 ข้อมูลพนักงาน (HR)
    ══════════════════════════════════════════════════════════════════════════════
    -->

    <!-- ══════════════════════════════════════════════════════════════════════
         🏠 ROOT APP — ไอคอนในแถบซ้ายสุด Odoo 19
    ══════════════════════════════════════════════════════════════════════════ -->
    <menuitem id="menu_warehousepart_root" name="ร้านอาหลั่ย" sequence="5" web_icon="warehousepart,static/description/icon.png"/>


    <!-- ══════════════════════════════════════════════════════════════════════
         [A] เมนูในแอป "ร้านอาหลั่ย"
    ══════════════════════════════════════════════════════════════════════════ -->

    <!-- 🏗️ คลัง / รับ-ส่งสินค้า (seq 10) — พนักงานคลัง กดรับ/ตรวจสอบสินค้า -->
    <menuitem id="menu_spare_warehouse_main" name="คลัง / รับ-ส่งสินค้า" parent="stock.menu_stock_root" groups="warehousepart.group_spare_inventory,warehousepart.group_spare_manager,warehousepart.group_spare_owner" sequence="10"/>

    <menuitem id="menu_goods_receipt_pending" name="รับสินค้าเข้าคลัง" parent="menu_spare_warehouse_main" action="action_goods_receipt_inventory" groups="warehousepart.group_spare_inventory,warehousepart.group_spare_manager,warehousepart.group_spare_owner" sequence="10"/>

    <menuitem id="menu_goods_receipt_all" name="ประวัติรับสินค้าทั้งหมด" parent="menu_spare_warehouse_main" action="action_goods_receipt_all" groups="warehousepart.group_spare_inventory,warehousepart.group_spare_manager,warehousepart.group_spare_owner" sequence="15"/>

    <menuitem id="menu_spare_delivery_carriers" name="วิธีการจัดส่ง" parent="menu_spare_warehouse_main" action="delivery.action_delivery_carrier_form" groups="warehousepart.group_spare_manager,warehousepart.group_spare_owner" sequence="20"/>

    <menuitem id="menu_spare_backorder_report" name="รายงานค้างรับ (Backorder)" parent="menu_spare_warehouse_main" action="action_spare_backorder_report" groups="warehousepart.group_spare_manager,warehousepart.group_spare_inventory,warehousepart.group_spare_owner" sequence="30"/>


    <!-- 📦 สินค้าและคลัง (seq 15) -->
    <menuitem id="menu_spare_parts_main" name="📦 สินค้าและคลัง" parent="menu_warehousepart_root" sequence="15"/>

    <menuitem id="menu_spare_part_list" name="แคตตาล็อกอะไหล่" parent="menu_spare_parts_main" action="action_spare_product_template" groups="warehousepart.group_spare_owner,warehousepart.group_spare_inventory,warehousepart.group_spare_accountant,warehousepart.group_spare_manager" sequence="10"/>

    <menuitem id="menu_spare_part_category" name="หมวดหมู่อะไหล่ (POS)" parent="menu_spare_parts_main" action="point_of_sale.product_pos_category_action" groups="warehousepart.group_spare_manager,warehousepart.group_spare_owner" sequence="20"/>

    <record id="action_stock_location_shelves" model="ir.actions.act_window">
        <field name="name">🗂️ ชั้นวางสินค้า</field>
        <field name="res_model">stock.location</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('usage','=','internal')]</field>
        <field name="context">{'default_usage': 'internal'}</field>
    </record>

    <menuitem id="menu_spare_shelf_locations" name="🗂️ ชั้นวางสินค้า (Shelf)" parent="menu_spare_parts_main" action="action_stock_location_shelves" groups="warehousepart.group_spare_front_staff,warehousepart.group_spare_inventory,warehousepart.group_spare_owner" sequence="30"/>

    <record id="action_stock_quant_front" model="ir.actions.act_window">
        <field name="name">📊 ดูสต็อกคลัง</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">list</field>
        <field name="domain">[('location_id.usage','=','internal')]</field>
        <field name="context">{'search_default_internal_loc': 1}</field>
    </record>

    <menuitem id="menu_front_stock_view" name="📊 ดูสต็อกคลัง" parent="menu_spare_parts_main" action="action_stock_quant_front" sequence="40"/>

    <!-- ⏱️ ระบบลงเวลาทำงาน (seq 30) — ทุก role เห็นได้ -->
    <menuitem id="menu_spare_attendance_main"
              name="⏱️ ระบบลงเวลาทำงาน"
              parent="menu_warehousepart_root"
              sequence="30"/>

    <!-- ทุก role: ดูเวลาของตัวเอง (domain กรองเฉพาะ employee ที่ผูกกับ user) -->
    <menuitem id="menu_spare_attendance_my_own"
              name="📋 บันทึกเวลาเข้า-ออกของฉัน"
              parent="menu_spare_attendance_main"
              action="action_attendance_my_own"
              sequence="10"/>

    <!-- เฉพาะบัญชี + เจ้าของ: ดูเวลาทุกคน -->
    <menuitem id="menu_spare_attendance_all"
              name="👥 เวลาทำงานทุกคน"
              parent="menu_spare_attendance_main"
              action="action_attendance_all_staff"
              groups="warehousepart.group_spare_accountant,warehousepart.group_spare_owner,base.group_system"
              sequence="20"/>

    <!-- เฉพาะ manager + เจ้าของ: สร้างข้อมูลสุ่ม -->
    <menuitem id="menu_spare_attendance_generate"
              name="🎲 สร้างข้อมูลสุ่ม (Generate)"
              parent="menu_spare_attendance_main"
              action="action_attendance_generate_wizard"
              groups="warehousepart.group_spare_owner,warehousepart.group_spare_manager"
              sequence="30"/>



    <!-- 🤝 ผู้ติดต่อ (seq 40) -->
    <record id="action_spare_customers" model="ir.actions.act_window">
        <field name="name">ลูกค้า (Customers)</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_customer': 1, 'res_partner_search_mode': 'customer', 'default_is_company': True, 'default_customer_rank': 1}</field>
    </record>

    <record id="action_spare_suppliers" model="ir.actions.act_window">
        <field name="name">ซัพพลายเออร์ (Suppliers)</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_supplier': 1, 'res_partner_search_mode': 'supplier', 'default_is_company': True, 'default_supplier_rank': 1}</field>
    </record>

    <menuitem id="menu_spare_contacts_main" name="🤝 ผู้ติดต่อ" parent="menu_warehousepart_root" groups="warehousepart.group_spare_manager,warehousepart.group_spare_owner" sequence="40"/>

    <menuitem id="menu_spare_customers" name="ลูกค้า (Customers)" parent="menu_spare_contacts_main" action="action_spare_customers" sequence="10"/>

    <menuitem id="menu_spare_suppliers" name="ซัพพลายเออร์ (Suppliers)" parent="menu_spare_contacts_main" action="action_spare_suppliers" sequence="20"/>


    <!-- 🌐 เว็บไซต์ (seq 50) -->
    <menuitem id="menu_spare_website_main" name="🌐 จัดการหน้าเว็บไซต์" parent="menu_warehousepart_root" groups="warehousepart.group_spare_manager,warehousepart.group_spare_owner" sequence="50"/>

    <menuitem id="menu_spare_flash_sale" name="⚡ ตั้งค่า Flash Sale" parent="menu_spare_website_main" action="action_flash_sale_config" groups="warehousepart.group_spare_manager,warehousepart.group_spare_owner" sequence="10"/>

    <menuitem id="menu_flash_sale_report" name="📊 รายงานยอดขาย Flash Sale" parent="menu_spare_website_main" action="action_flash_sale_report" groups="warehousepart.group_spare_manager,warehousepart.group_spare_owner" sequence="15"/>

    <menuitem id="menu_spare_homepage_product" name="⭐ สินค้าแนะนำหน้าแรก" parent="menu_spare_website_main" action="action_homepage_product" groups="warehousepart.group_spare_manager,warehousepart.group_spare_owner" sequence="20"/>

    <menuitem id="menu_spare_homepage_category" name="📁 จัดการหมวดหมู่หน้าแรก" parent="menu_spare_website_main" action="action_homepage_category" groups="warehousepart.group_spare_manager,warehousepart.group_spare_owner" sequence="30"/>


    <!-- ══════════════════════════════════════════════════════════════════════
         [B] บัญชีร้านอาหลั่ย — ฝากอยู่ใน "ออกใบแจ้งหนี้" (account.menu_finance)
         ใช้ sequence 90+ เพื่อแสดงอยู่ท้ายสุดของเมนู Invoicing
    ══════════════════════════════════════════════════════════════════════════ -->

    <!-- หัวข้อกลุ่ม: ─── บัญชีร้านอาหลั่ย ─── -->
    <menuitem id="menu_spare_acct_section" name="บัญชีการขาย" parent="account.menu_finance" groups="warehousepart.group_spare_accountant,warehousepart.group_spare_owner,base.group_system" sequence="90"/>

    <!-- 📅 สรุปรายรับ-รายจ่ายประจำวัน -->
    <menuitem id="menu_daily_summary" name="สรุปรายรับ-รายจ่ายประจำวัน" parent="menu_spare_acct_section" action="action_daily_summary" groups="warehousepart.group_spare_accountant,warehousepart.group_spare_owner,base.group_system" sequence="10"/>

    <!-- 🔄 Sync ยอดขาย POS → บัญชี (บัญชีดึงได้เองไม่ต้องเป็น Cashier) -->
    <menuitem id="menu_pos_sync_wizard" name="Sync ยอดขาย POS → บัญชี" parent="menu_spare_acct_section" action="action_pos_sync_wizard" groups="warehousepart.group_spare_accountant,warehousepart.group_spare_owner,base.group_system" sequence="15"/>

    <!-- 📊 รายรับ-รายจ่ายทั้งหมด -->
    <menuitem id="menu_store_income_expense_all" name="รายรับ-รายจ่ายทั้งหมด" parent="menu_spare_acct_section" action="action_store_income_expense" groups="warehousepart.group_spare_accountant,warehousepart.group_spare_owner,base.group_system" sequence="20"/>

    <menuitem id="menu_store_income_only" name="รายรับ (Income)" parent="menu_spare_acct_section" action="action_store_income_only" groups="warehousepart.group_spare_accountant,warehousepart.group_spare_owner,base.group_system" sequence="25"/>

    <menuitem id="menu_store_expense_only" name="รายจ่าย (Expense)" parent="menu_spare_acct_section" action="action_store_expense_only" groups="warehousepart.group_spare_accountant,warehousepart.group_spare_owner,base.group_system" sequence="30"/>

    <!-- 💸 จ่ายเงินเดือนพนักงาน -->
    <menuitem id="menu_spare_salary_payment" name="จ่ายเงินเดือนพนักงาน" parent="menu_spare_acct_section" action="action_salary_payment" groups="warehousepart.group_spare_accountant,warehousepart.group_spare_owner,base.group_system" sequence="40"/>

    <!-- 📈 รายได้สุทธิสินค้า -->
    <menuitem id="menu_product_income" name="รายได้สุทธิสินค้า" parent="menu_spare_acct_section" action="action_product_income" groups="warehousepart.group_spare_accountant,warehousepart.group_spare_owner,base.group_system" sequence="50"/>

    <menuitem id="menu_product_income_sync" name="Sync รายได้สุทธิจาก POS" parent="menu_spare_acct_section" action="action_product_income_sync_wizard" groups="warehousepart.group_spare_accountant,warehousepart.group_spare_owner,base.group_system" sequence="55"/>

    <!-- 👥 ข้อมูลพนักงาน HR -->
    <!-- <record id="action_spare_hr_employees_salary" model="ir.actions.act_window">
        <field name="name">👥 ข้อมูลพนักงาน (HR)</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>

    <menuitem id="menu_spare_hr_salary" name="👥 ข้อมูลพนักงาน (HR)" parent="menu_spare_acct_section" action="action_spare_hr_employees_salary" groups="warehousepart.group_spare_accountant,warehousepart.group_spare_owner,base.group_system" sequence="60"/>
-->
    <!-- ย้ายเมนูการกำหนดค่า (Configuration) ให้อยู่หลัง "บัญชี" ในแถบเมนูบน
         sequence 80 = อยู่ก่อน "บัญชีการขาย" (seq 90) -->
    <menuitem id="account.menu_finance_configuration"
              parent="account.menu_finance"
              sequence="80"/>
</odoo>