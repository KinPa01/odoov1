<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ══════════════════════════════════════════════════════════════════
             📥 Wizard: ดึงสลิปเงินเดือน HR → ระบบบัญชีร้าน
             store.payslip.import.wizard
        ══════════════════════════════════════════════════════════════════════ -->

        <record id="view_payslip_import_wizard_form" model="ir.ui.view">
            <field name="name">store.payslip.import.wizard.form</field>
            <field name="model">store.payslip.import.wizard</field>
            <field name="arch" type="xml">
                <form string="📥 ดึงสลิปเงินเดือน HR → บัญชีร้าน">
                    <sheet>
                        <div class="oe_title">
                            <h2>📥 นำเข้าเงินเดือนจาก HR Payslip</h2>
                            <p class="text-muted">
                                ดึงข้อมูลจาก <b>สลิปเงินเดือน (hr.payslip)</b> ที่ Confirm/Done แล้ว
                                เข้าระบบ <b>จ่ายเงินเดือนพนักงาน</b> ของร้านอัตโนมัติ
                                โดยดึงฐานเดือน (BASIC), รายหัก (GROSS-NET), OT, และ Net ให้ครบถ้วน
                            </p>
                        </div>

                        <group>
                            <group string="📅 เลือกเดือน">
                                <field name="month" string="เดือน"/>
                                <field name="year"  string="ปี (ค.ศ.)"/>
                                <field name="payment_date" string="วันที่จ่าย (ในระบบ)"/>
                            </group>
                            <group string="⚙️ ตัวเลือก">
                                <field name="state_filter" string="กรองสถานะ Payslip"/>
                                <field name="overwrite"    string="เขียนทับรายการที่มีแล้ว"/>
                            </group>
                        </group>

                        <div class="alert alert-info" role="alert">
                            <b>💡 ระบบจะดึงข้อมูลดังนี้:</b>
                            <ul class="mb-0 mt-1">
                                <li>เงินเดือนพื้นฐาน ← salary rule code <b>BASIC</b></li>
                                <li>ค่า OT ← salary rule code <b>OT</b></li>
                                <li>ยอดสุทธิ ← salary rule code <b>NET</b></li>
                                <li>รายหัก = GROSS − NET (คำนวณอัตโนมัติ)</li>
                            </ul>
                        </div>

                        <div class="alert alert-warning" role="alert">
                            <b>⚠️ หมายเหตุ:</b> รายการที่ดึงมาจะอยู่ในสถานะ <b>ร่าง</b>
                            ต้องเข้าไปยืนยันและกด <b>จ่ายแล้ว</b> ในหน้าจ่ายเงินเดือนอีกครั้ง
                        </div>
                    </sheet>
                    <footer>
                        <button name="action_import"
                                string="📥 ดึงข้อมูลจาก HR Payslip"
                                type="object"
                                class="btn-primary"/>
                        <button string="ยกเลิก" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Action เปิด wizard -->
        <record id="action_payslip_import_wizard" model="ir.actions.act_window">
            <field name="name">📥 ดึงเงินเดือนจาก HR Payslip</field>
            <field name="res_model">store.payslip.import.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

    </data>
</odoo>
