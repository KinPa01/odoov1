<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Customize the Standard External Layout for all PDF Reports (Invoices, PO, SO, Delivery Slips) -->
    <record id="ran_ahlai_external_layout_standard" model="ir.ui.view">
        <field name="name">ran_ahlai_external_layout_standard</field>
        <field name="inherit_id" ref="web.external_layout_standard"/>
        <field name="mode">extension</field>
        <field name="type">qweb</field>
        <field name="arch" type="xml">
            <!-- Inject CSS Styles Globally for All Documents -->
            <xpath expr="//div[contains(@t-attf-class, 'header')]" position="before">
                <style type="text/css">
                    @import url('https://fonts.googleapis.com/css2?family=Sarabun:ital,wght@0,300;0,400;0,500;0,700;1,400&amp;display=swap');

                    /* Global Font Setup */
                    html, body, p, div, span, table, tr, td, th, h1, h2, h3, h4, h5, h6, strong, em {
                        font-family: 'Sarabun', 'Tahoma', 'Leelawadee UI', 'Segoe UI', 'Angsana New', 'Cordia New', sans-serif !important;
                    }

                    /* Document title styling */
                    h2, .layout_document_title, h2 span, h3 span, h2 strong, h2 t {
                        color: #8b1515 !important;
                        font-weight: 700 !important;
                        font-size: 26px !important;
                        margin-top: 15px !important;
                        margin-bottom: 15px !important;
                    }

                    /* Address info styling */
                    address, [name="address"], [name="information_block"], .address {
                        border-left: 3px solid #dca816 !important;
                        padding-left: 12px !important;
                        font-size: 12px !important;
                        line-height: 1.5 !important;
                        margin-bottom: 15px !important;
                    }

                    /* Table grid borders and colors */
                    .o_main_table {
                        border: 1px solid #dee2e6 !important;
                        border-collapse: collapse !important;
                        width: 100% !important;
                        margin-top: 15px !important;
                        margin-bottom: 20px !important;
                    }
                    .o_main_table thead {
                        display: table-row-group !important;
                    }
                    .o_main_table thead tr {
                        background-color: #8b1515 !important;
                        color: #ffffff !important;
                        border-bottom: 2px solid #dca816 !important;
                    }
                    .o_main_table thead th {
                        color: #ffffff !important;
                        font-weight: bold !important;
                        font-size: 12px !important;
                        padding: 10px 8px !important;
                        border: 1px solid #8b1515 !important;
                        text-align: center;
                    }
                    .o_main_table thead th.text-start, .o_main_table tbody td.text-start {
                        text-align: left !important;
                    }
                    .o_main_table thead th.text-end, .o_main_table tbody td.text-end {
                        text-align: right !important;
                    }
                    .o_main_table tbody tr {
                        border-bottom: 1px solid #dee2e6 !important;
                    }
                    .o_main_table tbody tr:nth-of-type(even) {
                        background-color: #f9fafb !important;
                    }
                    .o_main_table tbody td {
                        padding: 8px 8px !important;
                        font-size: 12px !important;
                        border-right: 1px solid #dee2e6 !important;
                        border-left: 1px solid #dee2e6 !important;
                        color: #333333 !important;
                        vertical-align: middle !important;
                    }

                    /* Metadata area styling */
                    #informations {
                        background-color: #f9fafb !important;
                        border: 1px solid #e5e7eb !important;
                        border-radius: 4px !important;
                        padding: 12px !important;
                        margin-bottom: 20px !important;
                    }
                    #informations .col, #informations [class*="col-"] {
                        font-size: 11px !important;
                        border-right: 1px solid #e5e7eb !important;
                    }
                    #informations .col:last-child, #informations [class*="col-"]:last-child {
                        border-right: none !important;
                    }
                    #informations strong {
                        color: #8b1515 !important;
                        font-size: 11px !important;
                        text-transform: uppercase !important;
                    }

                    /* Totals table styling */
                    .o_total_table {
                        border: 1px solid #dee2e6 !important;
                        background-color: #ffffff !important;
                        width: 100% !important;
                    }
                    .o_total_table tr {
                        border-bottom: 1px solid #eee !important;
                    }
                    .o_total_table tr td {
                        padding: 6px 8px !important;
                        font-size: 12px !important;
                    }
                    .o_total_table tr.o_subtotal, .o_total_table tr:first-child {
                        border-top: 1px solid #dee2e6 !important;
                    }
                    .o_total_table tr.o_total, .o_total_table tr:last-child {
                        background-color: #8b1515 !important;
                        color: #ffffff !important;
                    }
                    .o_total_table tr.o_total td, .o_total_table tr.o_total td span, .o_total_table tr.o_total td strong,
                    .o_total_table tr:last-child td, .o_total_table tr:last-child td span, .o_total_table tr:last-child td strong {
                        color: #ffffff !important;
                        font-size: 14px !important;
                        font-weight: bold !important;
                    }

                    /* Signature Box styling */
                    .signature-box {
                        border: 1px solid #dee2e6 !important;
                        border-radius: 4px !important;
                        padding: 15px 10px !important;
                        background-color: #f9fafb !important;
                        min-height: 110px;
                        margin-bottom: 15px;
                    }
                </style>
            </xpath>

            <!-- Replace the header layout -->
            <xpath expr="//div[contains(@t-attf-class, 'header')]" position="replace">
                <div class="header" style="border-bottom: 3px solid #8b1515; border-top: 4px solid #dca816; padding-bottom: 12px; margin-bottom: 20px;">
                    <div class="row">
                        <!-- Left: Brand Logo/Name -->
                        <div class="col-4 mb4" style="margin-top: 10px;">
                            <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 65px;" alt="Logo"/>
                            <h2 t-if="not company.logo" style="color: #8b1515; font-weight: 900; margin: 0; letter-spacing: -0.5px; font-size: 28px;">ร้านอาหลั่ย</h2>
                            <div style="color: #dca816; font-size: 13px; font-weight: 700; margin-top: 5px; text-transform: uppercase; letter-spacing: 0.5px;">อะไหล่แท้ ราคาดี ส่งทั่วไทย</div>
                        </div>
                        <!-- Right: Company Contact details -->
                        <div class="col-8 text-end" style="margin-top: 5px;">
                            <h4 style="color: #8b1515; font-weight: 800; margin-bottom: 5px; font-size: 18px;"><span t-field="company.name"/></h4>
                            <div style="color: #555; font-size: 11px; margin-bottom: 5px; line-height: 1.4;">
                                <span t-if="company.street"><t t-esc="company.street"/></span>
                                <span t-if="company.city"><t t-esc="company.city"/></span>
                                <span t-if="company.state_id"><t t-esc="company.state_id.name"/></span>
                                <span t-if="company.zip"><t t-esc="company.zip"/></span>
                            </div>
                            <div style="font-size: 11px; font-weight: bold; background-color: #f9fafb; padding: 6px 12px; border-radius: 4px; display: inline-block; border: 1px solid #eee;">
                                <span t-if="company.phone" style="color: #8b1515;"><i class="fa fa-phone mr-1"></i> <t t-esc="company.phone"/></span>
                                <span t-if="company.phone and company.email" class="mx-2 text-muted">|</span>
                                <span t-if="company.email" style="color: #8b1515;"><i class="fa fa-envelope mr-1"></i> <t t-esc="company.email"/></span>
                                <span t-if="company.vat" class="mx-2 text-muted">|</span>
                                <span t-if="company.vat" style="color: #8b1515;"><i class="fa fa-building mr-1"></i> เลขผู้เสียภาษี: <t t-esc="company.vat"/></span>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>

            <!-- Replace the footer layout -->
            <xpath expr="//div[contains(@t-attf-class, 'footer')]" position="replace">
                <div class="footer o_standard_footer" style="border-top: 2px solid #8b1515; padding-top: 12px;">
                    <div class="row">
                        <div class="col-8">
                            <div style="color: #8b1515; font-weight: bold; font-size: 13px;">ร้านอาหลั่ย - ศูนย์รวมอะไหล่รถยนต์คุณภาพสูง</div>
                            <div style="color: #777; font-size: 10px; margin-top: 3px;">
                                สินค้าทุกชิ้นรับประกันคุณภาพตามมาตรฐานผู้ผลิต • หากต้องการเคลมหรือเปลี่ยนสินค้า กรุณานำใบเสร็จนี้มาแสดงภายใน 7 วัน
                            </div>
                        </div>
                        <div class="col-4 text-end">
                            <div t-if="report_type == 'pdf'" class="text-muted" style="font-size: 11px; font-weight: bold;">
                                หน้า <span class="page"/> จาก <span class="topage"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Customize specific Invoice template to add Thai Signature Block -->
    <record id="ran_ahlai_report_invoice_document" model="ir.ui.view">
        <field name="name">ran_ahlai_report_invoice_document</field>
        <field name="inherit_id" ref="account.report_invoice_document"/>
        <field name="mode">extension</field>
        <field name="type">qweb</field>
        <field name="arch" type="xml">
            <!-- Inject Thai Signature Blocks at the bottom of the page, after the payment term details -->
            <xpath expr="//div[@id='payment_term']" position="after">
                <div class="row mt-5 avoid-page-break-inside" style="page-break-inside: avoid;">
                    <div class="col-4">
                        <div class="signature-box text-center">
                           <div style="font-size: 12px; font-weight: bold; color: #333; margin-bottom: 45px;">ผู้รับสินค้า / Recipient</div>
                           <div style="border-bottom: 1px dashed #999; width: 85%; margin: 0 auto 5px auto;"></div>
                           <div style="font-size: 11px; color: #666;">วันที่ / Date: ______/______/______</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="signature-box text-center">
                           <div style="font-size: 12px; font-weight: bold; color: #333; margin-bottom: 45px;">ผู้ส่งสินค้า / Deliverer</div>
                           <div style="border-bottom: 1px dashed #999; width: 85%; margin: 0 auto 5px auto;"></div>
                           <div style="font-size: 11px; color: #666;">วันที่ / Date: ______/______/______</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="signature-box text-center">
                           <div style="font-size: 12px; font-weight: bold; color: #333; margin-bottom: 45px;">ผู้รับเงิน / Authorized Signature</div>
                           <div style="border-bottom: 1px dashed #999; width: 85%; margin: 0 auto 5px auto;"></div>
                           <div style="font-size: 11px; color: #666;">วันที่ / Date: ______/______/______</div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Customize specific Purchase Order template to add Thai Signature Block -->
    <record id="ran_ahlai_report_purchaseorder_document" model="ir.ui.view">
        <field name="name">ran_ahlai_report_purchaseorder_document</field>
        <field name="inherit_id" ref="purchase.report_purchaseorder_document"/>
        <field name="mode">extension</field>
        <field name="type">qweb</field>
        <field name="arch" type="xml">
            <!-- Inject Thai Signature Blocks at the bottom of the page, after the main content -->
            <xpath expr="//div[@id='total']" position="after">
                <div class="row mt-5 avoid-page-break-inside" style="page-break-inside: avoid;">
                    <div class="col-4">
                        <div class="signature-box text-center">
                           <div style="font-size: 12px; font-weight: bold; color: #333; margin-bottom: 45px;">ผู้สั่งซื้อ / Buyer</div>
                           <div style="border-bottom: 1px dashed #999; width: 85%; margin: 0 auto 5px auto;"></div>
                           <div style="font-size: 11px; color: #666;">วันที่ / Date: ______/______/______</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="signature-box text-center">
                           <div style="font-size: 12px; font-weight: bold; color: #333; margin-bottom: 45px;">ผู้ตรวจสอบ / Checked by</div>
                           <div style="border-bottom: 1px dashed #999; width: 85%; margin: 0 auto 5px auto;"></div>
                           <div style="font-size: 11px; color: #666;">วันที่ / Date: ______/______/______</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="signature-box text-center">
                           <div style="font-size: 12px; font-weight: bold; color: #333; margin-bottom: 45px;">ผู้อนุมัติ / Authorized Signature</div>
                           <div style="border-bottom: 1px dashed #999; width: 85%; margin: 0 auto 5px auto;"></div>
                           <div style="font-size: 11px; color: #666;">วันที่ / Date: ______/______/______</div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Customize specific Sales Order / Quotation template to add Thai Signature Block -->
    <record id="ran_ahlai_report_saleorder_document" model="ir.ui.view">
        <field name="name">ran_ahlai_report_saleorder_document</field>
        <field name="inherit_id" ref="sale.report_saleorder_document"/>
        <field name="mode">extension</field>
        <field name="type">qweb</field>
        <field name="arch" type="xml">
            <!-- Inject Thai Signature Blocks right after the totals block -->
            <xpath expr="//div[@name='so_total_summary']" position="after">
                <div class="row mt-5 avoid-page-break-inside" style="page-break-inside: avoid;">
                    <div class="col-4">
                        <div class="signature-box text-center">
                           <div style="font-size: 12px; font-weight: bold; color: #333; margin-bottom: 45px;">ผู้เสนอราคา / Prepared by</div>
                           <div style="border-bottom: 1px dashed #999; width: 85%; margin: 0 auto 5px auto;"></div>
                           <div style="font-size: 11px; color: #666;">วันที่ / Date: ______/______/______</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="signature-box text-center">
                           <div style="font-size: 12px; font-weight: bold; color: #333; margin-bottom: 45px;">ผู้ตรวจสอบ / Checked by</div>
                           <div style="border-bottom: 1px dashed #999; width: 85%; margin: 0 auto 5px auto;"></div>
                           <div style="font-size: 11px; color: #666;">วันที่ / Date: ______/______/______</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="signature-box text-center">
                           <div style="font-size: 12px; font-weight: bold; color: #333; margin-bottom: 45px;">ผู้อนุมัติสั่งซื้อ / Authorized Signature</div>
                           <div style="border-bottom: 1px dashed #999; width: 85%; margin: 0 auto 5px auto;"></div>
                           <div style="font-size: 11px; color: #666;">วันที่ / Date: ______/______/______</div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
