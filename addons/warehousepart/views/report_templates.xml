<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Customize the Standard External Layout for all PDF Reports (Invoices, PO, SO, Delivery Slips) -->
    <record id="ran_ahlai_external_layout_standard" model="ir.ui.view">
        <field name="name">ran_ahlai_external_layout_standard</field>
        <field name="inherit_id" ref="web.external_layout_standard"/>
        <field name="mode">extension</field>
        <field name="type">qweb</field>
        <field name="arch" type="xml">
            <!-- Replace the header -->
            <xpath expr="//div[contains(@t-attf-class, 'header')]" position="replace">
                <div class="header" style="border-bottom: 4px solid #8b1515; padding-bottom: 15px; margin-bottom: 20px;">
                    <div class="row">
                        <div class="col-4 mb4">
                            <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 60px;" alt="Logo"/>
                            <h2 t-if="not company.logo" style="color: #8b1515; font-weight: 900; margin: 0; letter-spacing: -0.5px;">ร้านอาหลั่ย</h2>
                            <div style="color: #dca816; font-size: 13px; font-weight: 700; margin-top: 5px;">อะไหล่แท้ ราคาดี ส่งทั่วไทย</div>
                        </div>
                        <div class="col-8 text-end" style="margin-top: 10px;">
                            <h4 style="color: #111; font-weight: 800; margin-bottom: 5px; font-size: 18px;"><span t-field="company.name"/></h4>
                            <div style="color: #555; font-size: 12px;" t-field="company.report_header" t-if="company.report_header"/>
                            <div style="color: #555; font-size: 12px; margin-bottom: 5px;">
                                <span t-if="company.street"><t t-esc="company.street"/></span>
                                <span t-if="company.city"><t t-esc="company.city"/></span>
                                <span t-if="company.state_id"><t t-esc="company.state_id.name"/></span>
                                <span t-if="company.zip"><t t-esc="company.zip"/></span>
                            </div>
                            <div style="font-size: 12px; font-weight: bold; background-color: #f9fafb; padding: 5px 10px; border-radius: 4px; display: inline-block; border: 1px solid #eee;">
                                <span t-if="company.phone" style="color: #8b1515;"><i class="fa fa-phone mr-1"></i> <t t-esc="company.phone"/></span>
                                <span t-if="company.phone and company.email" class="mx-2 text-muted">|</span>
                                <span t-if="company.email" style="color: #8b1515;"><i class="fa fa-envelope mr-1"></i> <t t-esc="company.email"/></span>
                                <span t-if="company.vat" class="mx-2 text-muted">|</span>
                                <span t-if="company.vat" style="color: #8b1515;"><i class="fa fa-building mr-1"></i> เลขประจำตัวผู้เสียภาษี: <t t-esc="company.vat"/></span>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>

            <!-- Replace the footer -->
            <xpath expr="//div[contains(@t-attf-class, 'footer')]" position="replace">
                <div class="footer o_standard_footer" style="border-top: 2px solid #8b1515; padding-top: 15px;">
                    <div class="row">
                        <div class="col-8">
                            <div style="color: #8b1515; font-weight: bold; font-size: 14px;">ร้านอาหลั่ย - ศูนย์รวมอะไหล่รถยนต์คุณภาพ</div>
                            <div style="color: #666; font-size: 11px; margin-top: 3px;">
                                สินค้าทุกชิ้นรับประกันคุณภาพตามมาตรฐานผู้ผลิต • ขอบคุณที่ไว้วางใจใช้บริการ
                            </div>
                        </div>
                        <div class="col-4 text-end">
                            <div t-if="report_type == 'pdf'" class="text-muted" style="font-size: 12px; font-weight: bold;">
                                หน้า <span class="page"/> จาก <span class="topage"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
