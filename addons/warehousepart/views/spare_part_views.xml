<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- สืบทอด Product Form View เพื่อแทรกฟิลด์ใหม่ -->
    <record id="view_product_template_form_inherit_spare" model="ir.ui.view">
        <field name="name">product.template.common.form.inherit.spare</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <!-- เพิ่ม Tab ใหม่สำหรับเก็บข้อมูลอะไหล่โดยเฉพาะ เพื่อไม่ให้ตีกับฟิลด์ Odoo -->
            <xpath expr="//notebook" position="inside">
                <page string="ข้อมูลอะไหล่รถยนต์" name="spare_part_info">
                    <group>
                        <group string="สเปกและรุ่นรถ (Fitment)">
                            <field name="part_brand"/>
                            <field name="car_model"/>
                            <field name="shelf_location" options="{'no_create': True, 'no_open': True}"/>
                        </group>
                        <group string="Webike Integration">
                            <field name="webike_url" widget="url"/>
                            <field name="webike_sku"/>
                        </group>
                    </group>
                    <!-- ─── สต็อกคลังหน้าร้าน (Real-time) ─────────────────────── -->
                    <group string="🏪 สต็อกคลังหน้าร้าน">
                        <group>
                            <field name="qty_pos_warehouse"
                                   string="🏪 คลังหน้าร้าน (POS)"
                                   readonly="1"
                                   help="จำนวนสินค้าในคลังหน้าร้าน — POS จะดึงสต็อกจากคลังนี้"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Inherit stock.picking form view to add shortage fields and stock info to move lines -->
    <record id="view_picking_form_inherit_shortage" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.shortage</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <!-- Inject Shelf location and Stock levels on move lines -->
            <xpath expr="//field[@name='move_ids']/list/field[@name='product_id']" position="after">
                <field name="shelf_location" optional="show"/>
                <field name="location_qty" string="สต็อกต้นทาง" optional="show" readonly="1" force_save="1"/>
                <field name="location_dest_qty" string="สต็อกปลายทาง" optional="show" readonly="1" force_save="1"/>
            </xpath>
            <xpath expr="//field[@name='move_ids']/list/field[@name='quantity']" position="after">
                <field name="shortage_reason" 
                       optional="show" 
                       column_invisible="parent.state == 'draft'" 
                       readonly="state in ('done', 'cancel')"/>
                <field name="shortage_note" 
                       optional="show" 
                       column_invisible="parent.state == 'draft'" 
                       readonly="state in ('done', 'cancel')"/>
            </xpath>
        </field>
    </record>
    
    <!-- Action สำหรับเปิดเฉพาะสินค้าที่เป็นอะไหล่ (ดึงหน้าจอมาตรฐาน) -->
    <record id="action_spare_product_template" model="ir.actions.act_window">
        <field name="name">รายการอะไหล่</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list,form,activity</field>
        <!-- Filter ให้เห็นสินค้าที่ใช้งานได้ใน POS หรือที่เป็นสินค้าชิ้นเป็นหลัก -->
        <field name="context">{'search_default_filter_to_sell': 1}</field>
    </record>
</odoo>
