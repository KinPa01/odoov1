<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════
         1. INJECT GOOGLE FONTS INTO WEBSITE HEAD
         ═══════════════════════════════════════════════════════════ -->
    <template id="ran_ahlai_google_fonts" inherit_id="website.layout" name="Ran Ahlai — Google Fonts">
        <xpath expr="//head" position="inside">
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
            <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sarabun:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&amp;family=Inter:wght@300;400;500;600;700;800;900&amp;display=swap"/>
        </xpath>
    </template>

    <!-- ═══════════════════════════════════════════════════════════
         2. HOMEPAGE OVERRIDE — DARK AUTOMOTIVE THEME
         ═══════════════════════════════════════════════════════════ -->
    <template id="ran_ahlai_homepage" inherit_id="website.homepage" name="Ran Ahlai — Dark Homepage">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure oe_empty ra-wrap">

                <!-- ╔══════════════════════════════════════════╗
                     ║           HERO SECTION                   ║
                     ╚══════════════════════════════════════════╝ -->
                <section class="ra-hero">
                    <div class="ra-hero-content">
                        <div class="container">
                            <div class="row align-items-center">

                                <!-- Left: Text Content -->
                                <div class="col-lg-6 col-md-12">
                                    <span class="ra-hero-badge">อะไหล่รถยนต์ พรีเมียม</span>

                                    <h1 class="ra-hero-title">
                                        อะไหล่แท้                                        <br/>
                                        <span>คุณภาพสูง</span>
                                    </h1>

                                    <p class="ra-hero-subtitle">ส่งตรงทั่วประเทศไทย</p>

                                    <p class="ra-hero-desc">
                                        รวบรวมอะไหล่รถยนต์แท้คุณภาพสูงจากผู้ผลิตมาตรฐาน OEM
                                        พร้อมจัดส่งรวดเร็วทั่วประเทศ การันตีคุณภาพทุกชิ้น
                                        โดยทีมผู้เชี่ยวชาญด้านอะไหล่มากกว่า 10 ปี
                                    </p>

                                    <div class="ra-hero-btns">
                                        <a href="/shop" id="hero-shop-btn" class="ra-btn-red">ดูสินค้าทั้งหมด →</a>
                                        <a href="/contactus" id="hero-contact-btn" class="ra-btn-outline">ติดต่อเรา</a>
                                    </div>

                                    <!-- Stats -->
                                    <div class="ra-hero-stats">
                                        <div class="ra-stat-item">
                                            <div class="ra-stat-num">5,000+</div>
                                            <div class="ra-stat-label">รายการสินค้า</div>
                                        </div>
                                        <div class="ra-stat-item">
                                            <div class="ra-stat-num">50+</div>
                                            <div class="ra-stat-label">แบรนด์ชั้นนำ</div>
                                        </div>
                                        <div class="ra-stat-item">
                                            <div class="ra-stat-num">24h</div>
                                            <div class="ra-stat-label">จัดส่งด่วน</div>
                                        </div>
                                        <div class="ra-stat-item">
                                            <div class="ra-stat-num">10ปี+</div>
                                            <div class="ra-stat-label">ประสบการณ์</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ╔══════════════════════════════════════════╗
                     ║         TRUST / FEATURES BAR             ║
                     ╚══════════════════════════════════════════╝ -->
                <section class="ra-features-bar">
                    <div class="container-fluid px-0">
                        <div class="row g-0">
                            <div class="col-md-3 col-6">
                                <div class="ra-feature-item">
                                    <div class="ra-feature-icon">🔩</div>
                                    <div class="ra-feature-text">
                                        <p class="ra-feature-title">อะไหล่แท้ 100%</p>
                                        <p class="ra-feature-desc">รับประกันจากผู้ผลิต OEM มาตรฐานสูง</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3 col-6">
                                <div class="ra-feature-item">
                                    <div class="ra-feature-icon">🚚</div>
                                    <div class="ra-feature-text">
                                        <p class="ra-feature-title">ส่งด่วน 1-3 วัน</p>
                                        <p class="ra-feature-desc">จัดส่งทั่วประเทศ Kerry Express</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3 col-6">
                                <div class="ra-feature-item">
                                    <div class="ra-feature-icon">💳</div>
                                    <div class="ra-feature-text">
                                        <p class="ra-feature-title">ชำระหลายช่องทาง</p>
                                        <p class="ra-feature-desc">โอน, บัตร, พร้อมเพย์, ผ่อน 0%</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3 col-6">
                                <div class="ra-feature-item">
                                    <div class="ra-feature-icon">🛡️</div>
                                    <div class="ra-feature-text">
                                        <p class="ra-feature-title">รับประกันสินค้า</p>
                                        <p class="ra-feature-desc">คืนสินค้าภายใน 7 วัน หากผิดรุ่น</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ╔══════════════════════════════════════════╗
                     ║           PROMO DUAL BANNERS             ║
                     ╚══════════════════════════════════════════╝ -->
                <section class="ra-promo-section">
                    <div class="container">
                        <div class="row g-4">

                            <!-- Banner 1: Dark — Featured Oil -->
                            <div class="col-md-6">
                                <a href="/shop" class="ra-promo-card ra-promo-dark d-block text-decoration-none">
                                    <div class="ra-promo-tag">⭐ สินค้าแนะนำ</div>
                                    <h3 class="ra-promo-title">
                                        น้ำมันเครื่อง                                        <br/>
                                        Synthetic พรีเมียม
                                    </h3>
                                    <p class="ra-promo-sub">
                                        ประสิทธิภาพสูงสุด ปกป้องเครื่องยนต์ทุกสภาวะ
                                        เหมาะสำหรับรถทุกประเภท
                                    </p>
                                    <span class="ra-promo-btn">ดูสินค้า →</span>
                                </a>
                            </div>

                            <!-- Banner 2: Red — Brake System -->
                            <div class="col-md-6">
                                <a href="/shop" class="ra-promo-card ra-promo-red d-block text-decoration-none">
                                    <div class="ra-promo-tag">🔥 ขายดี</div>
                                    <h3 class="ra-promo-title">
                                        ผ้าเบรก &amp;<br/>
                                        จานเบรกคุณภาพสูง
                                    </h3>
                                    <p class="ra-promo-sub">
                                        ปลอดภัยสูงสุด หยุดได้แม่นยำ ราคาถูกกว่าศูนย์
                                    </p>
                                    <span class="ra-promo-btn">SHOP NOW →</span>
                                </a>
                            </div>

                        </div>
                    </div>
                </section>

                <!-- ╔══════════════════════════════════════════╗
                     ║           CATEGORIES GRID                ║
                     ╚══════════════════════════════════════════╝ -->
                <section class="ra-categories-section">
                    <div class="container">
                        <div class="ra-section-header">
                            <div>
                                <span class="ra-section-badge">หมวดหมู่สินค้า</span>
                                <h2 class="ra-section-title">เลือกตามประเภทอะไหล่</h2>
                                <div class="ra-divider"></div>
                            </div>
                            <a href="/shop" class="ra-view-all">ดูทั้งหมด →</a>
                        </div>

                        <!-- JS จะ render หมวดหมู่จาก /homepage/categories API -->
                        <div class="ra-cat-grid" id="ra-cat-grid">
                            <!-- Skeleton loaders แสดงขณะโหลด -->
                            <div class="ra-cat-card ra-cat-skeleton"><span class="ra-skeleton-icon"></span><span class="ra-skeleton-line"></span><span class="ra-skeleton-line ra-skeleton-short"></span></div>
                            <div class="ra-cat-card ra-cat-skeleton"><span class="ra-skeleton-icon"></span><span class="ra-skeleton-line"></span><span class="ra-skeleton-line ra-skeleton-short"></span></div>
                            <div class="ra-cat-card ra-cat-skeleton"><span class="ra-skeleton-icon"></span><span class="ra-skeleton-line"></span><span class="ra-skeleton-line ra-skeleton-short"></span></div>
                            <div class="ra-cat-card ra-cat-skeleton"><span class="ra-skeleton-icon"></span><span class="ra-skeleton-line"></span><span class="ra-skeleton-line ra-skeleton-short"></span></div>
                            <div class="ra-cat-card ra-cat-skeleton"><span class="ra-skeleton-icon"></span><span class="ra-skeleton-line"></span><span class="ra-skeleton-line ra-skeleton-short"></span></div>
                            <div class="ra-cat-card ra-cat-skeleton"><span class="ra-skeleton-icon"></span><span class="ra-skeleton-line"></span><span class="ra-skeleton-line ra-skeleton-short"></span></div>
                        </div>
                    </div>
                </section>

                <!-- ╔══════════════════════════════════════════╗
                     ║           BEST SELLERS SECTION           ║
                     ╚══════════════════════════════════════════╝ -->
                <section class="ra-products-section">
                    <div class="container">
                        <div class="ra-section-header">
                            <div>
                                <span class="ra-section-badge">สินค้าแนะนำ</span>
                                <h2 class="ra-section-title">Best Sellers</h2>
                                <div class="ra-divider"></div>
                            </div>
                            <a href="/shop" class="ra-view-all">ดูสินค้าทั้งหมด →</a>
                        </div>

                        <!-- JS render จาก /homepage/best-sellers API -->
                        <div class="row g-4" id="ra-best-sellers-grid">
                            <!-- Skeleton loaders -->
                            <div class="col-6 col-md-3"><div class="ra-product-card ra-product-skeleton"><div class="ra-sku-img-skeleton"></div><div class="ra-sku-name-skeleton"></div><div class="ra-sku-price-skeleton"></div></div></div>
                            <div class="col-6 col-md-3"><div class="ra-product-card ra-product-skeleton"><div class="ra-sku-img-skeleton"></div><div class="ra-sku-name-skeleton"></div><div class="ra-sku-price-skeleton"></div></div></div>
                            <div class="col-6 col-md-3"><div class="ra-product-card ra-product-skeleton"><div class="ra-sku-img-skeleton"></div><div class="ra-sku-name-skeleton"></div><div class="ra-sku-price-skeleton"></div></div></div>
                            <div class="col-6 col-md-3"><div class="ra-product-card ra-product-skeleton"><div class="ra-sku-img-skeleton"></div><div class="ra-sku-name-skeleton"></div><div class="ra-sku-price-skeleton"></div></div></div>
                        </div>
                    </div>
                </section>

                <!-- ╔══════════════════════════════════════════╗
                     ║           FLASH SALE SECTION             ║
                     ╚══════════════════════════════════════════╝ -->
                <section class="ra-flash-section">
                    <div class="container">
                        <div class="ra-section-header align-items-end">
                            <div>
                                <span class="ra-flash-label" id="ra-flash-label">⚡ FLASH SALE</span>
                                <h2 class="ra-section-title d-flex align-items-center gap-2 gap-md-3 flex-wrap">
                                    <span>Flash Sale</span>
                                    <div class="ra-countdown ms-1 ms-md-2" id="ra-countdown">
                                        <div class="ra-countdown-item">
                                            <span class="ra-count-num" id="ra-hours">--</span>
                                            <span class="ra-count-label">ชั่วโมง</span>
                                        </div>
                                        <span class="ra-countdown-sep">:</span>
                                        <div class="ra-countdown-item">
                                            <span class="ra-count-num" id="ra-mins">--</span>
                                            <span class="ra-count-label">นาที</span>
                                        </div>
                                        <span class="ra-countdown-sep">:</span>
                                        <div class="ra-countdown-item">
                                            <span class="ra-count-num" id="ra-secs">--</span>
                                            <span class="ra-count-label">วินาที</span>
                                        </div>
                                    </div>
                                </h2>
                                <div class="ra-divider"></div>
                                <!-- Progress bar: แสดงเวลาที่เหลือในรอบ Flash Sale -->
                                <div class="ra-flash-progress-wrap" style="margin-top:6px;">
                                    <div id="ra-flash-progress" class="ra-flash-progress-bar" style="width:100%;"></div>
                                </div>
                            </div>
                            <a href="/shop" id="ra-flash-view-all" class="ra-view-all">ดูโปรทั้งหมด →</a>
                        </div>

                        <!-- Flash Sale product grid — JS renders real products from API -->
                        <div class="row g-4" id="ra-flash-grid">
                            <!-- Skeleton loaders แสดงขณะโหลดข้อมูล Flash Sale -->
                            <div class="col-6 col-md-3"><div class="ra-product-card ra-product-skeleton"><div class="ra-sku-img-skeleton"></div><div class="ra-sku-name-skeleton"></div><div class="ra-sku-price-skeleton"></div></div></div>
                            <div class="col-6 col-md-3"><div class="ra-product-card ra-product-skeleton"><div class="ra-sku-img-skeleton"></div><div class="ra-sku-name-skeleton"></div><div class="ra-sku-price-skeleton"></div></div></div>
                            <div class="col-6 col-md-3"><div class="ra-product-card ra-product-skeleton"><div class="ra-sku-img-skeleton"></div><div class="ra-sku-name-skeleton"></div><div class="ra-sku-price-skeleton"></div></div></div>
                            <div class="col-6 col-md-3"><div class="ra-product-card ra-product-skeleton"><div class="ra-sku-img-skeleton"></div><div class="ra-sku-name-skeleton"></div><div class="ra-sku-price-skeleton"></div></div></div>
                        </div>
                    </div>
                </section>

                <!-- ╔══════════════════════════════════════════╗
                     ║           BRAND LOGOS BAR                ║
                     ╚══════════════════════════════════════════╝ -->
                <section class="ra-brands-section">
                    <div class="container">
                        <p class="ra-brands-title">รองรับรถยนต์ยี่ห้อชั้นนำ</p>
                        <div class="ra-brands-grid">
                            <div class="ra-brand-badge">TOYOTA</div>
                            <div class="ra-brand-badge">HONDA</div>
                            <div class="ra-brand-badge">ISUZU</div>
                            <div class="ra-brand-badge">MITSUBISHI</div>
                            <div class="ra-brand-badge">NISSAN</div>
                            <div class="ra-brand-badge">MAZDA</div>
                            <div class="ra-brand-badge">FORD</div>
                            <div class="ra-brand-badge">BMW</div>
                            <div class="ra-brand-badge">MERCEDES</div>
                            <div class="ra-brand-badge">SUZUKI</div>
                            <div class="ra-brand-badge">CHEVROLET</div>
                            <div class="ra-brand-badge">HYUNDAI</div>
                        </div>
                    </div>
                </section>

            </div>            <!-- /ra-wrap -->
        </xpath>
    </template>

    <!-- ═══════════════════════════════════════════════════════════
         3. SHOP PAGE — ENABLE CATEGORIES SIDEBAR
         ═══════════════════════════════════════════════════════════ -->
    <record id="website_sale.products_categories" model="ir.ui.view">
        <field name="active" eval="True"/>
    </record>

    <!-- ═══════════════════════════════════════════════════════════
         4. PORTAL MY ORDERS — SHOPEE-LIKE TABS
         ═══════════════════════════════════════════════════════════ -->
    <template id="portal_my_orders_shopee_tabs" inherit_id="sale.portal_my_orders" name="Shopee-Like Order Tabs">
        <xpath expr="//t[@t-call='portal.portal_searchbar']" position="after">
            <div class="ra-order-tabs-container mb-4 mt-3 bg-white rounded shadow-sm">
                <ul class="nav nav-tabs ra-order-tabs d-flex justify-content-between border-0 text-center" role="tablist">
                    <li class="nav-item flex-fill">
                        <a t-attf-class="nav-link #{current_tab == 'all' and 'active' or ''}" href="/my/orders?tab=all">
                            ทั้งหมด
                        </a>
                    </li>
                    <li class="nav-item flex-fill">
                        <a t-attf-class="nav-link #{current_tab == 'to_pay' and 'active' or ''}" href="/my/orders?tab=to_pay">
                            ที่ต้องชำระ 
                            <span t-if="tab_counts and tab_counts.get('to_pay', 0) > 0" class="badge rounded-pill bg-danger">
                                <t t-esc="tab_counts['to_pay']"/>
                            </span>
                        </a>
                    </li>
                    <li class="nav-item flex-fill">
                        <a t-attf-class="nav-link #{current_tab == 'to_ship' and 'active' or ''}" href="/my/orders?tab=to_ship">
                            ที่ต้องจัดส่ง
                            <span t-if="tab_counts and tab_counts.get('to_ship', 0) > 0" class="badge rounded-pill bg-danger">
                                <t t-esc="tab_counts['to_ship']"/>
                            </span>
                        </a>
                    </li>
                    <li class="nav-item flex-fill">
                        <a t-attf-class="nav-link #{current_tab == 'to_receive' and 'active' or ''}" href="/my/orders?tab=to_receive">
                            ที่ต้องได้รับ
                            <span t-if="tab_counts and tab_counts.get('to_receive', 0) > 0" class="badge rounded-pill bg-danger">
                                <t t-esc="tab_counts['to_receive']"/>
                            </span>
                        </a>
                    </li>
                    <li class="nav-item flex-fill">
                        <a t-attf-class="nav-link #{current_tab == 'completed' and 'active' or ''}" href="/my/orders?tab=completed">
                            สำเร็จแล้ว
                            <span t-if="tab_counts and tab_counts.get('completed', 0) > 0" class="badge rounded-pill bg-success">
                                <t t-esc="tab_counts['completed']"/>
                            </span>
                        </a>
                    </li>
                    <li class="nav-item flex-fill">
                        <a t-attf-class="nav-link #{current_tab == 'cancelled' and 'active' or ''}" href="/my/orders?tab=cancelled">
                            ยกเลิกแล้ว
                        </a>
                    </li>
                </ul>
            </div>
        </xpath>

        <xpath expr="//t[@t-if='orders']" position="replace">
            <t t-if="orders">
                <div class="ra-order-list d-flex flex-column gap-3 mt-3">
                    <t t-foreach="orders" t-as="order">
                        <div class="card border-0 shadow-sm rounded-3">
                            <!-- Card Header -->
                            <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center pt-3 pb-2">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-danger rounded-pill" style="font-size: 0.75rem;">ร้านแนะนำดีเยี่ยม</span>
                                    <span class="fw-bold text-dark">
                                        <t t-esc="order.company_id.name or 'ร้านอาหลั่ย'"/>
                                    </span>
                                </div>
                                <div class="text-end fw-bold" style="color: #dc3545; font-size: 0.9rem;">
                                    <t t-if="order.delivery_status == 'full' and not order.customer_received">
                                        รอการยืนยัน
                                    </t>
                                    <t t-elif="order.customer_received">
                                        สำเร็จ
                                    </t>
                                    <t t-else="">
                                        <span t-if="order.state == 'cancel'">ยกเลิก</span>
                                        <span t-elif="order.delivery_status == 'pending'">ที่ต้องจัดส่ง</span>
                                        <span t-elif="order.delivery_status == 'partial'">ทยอยจัดส่ง</span>
                                        <span t-elif="order.state in ['draft', 'sent']">ที่ต้องชำระ</span>
                                        <span t-else="">รอดำเนินการ</span>
                                    </t>
                                </div>
                            </div>

                            <!-- Card Body (First Product) -->
                            <t t-set="prod_lines" t-value="order.order_line.filtered(lambda l: not l.is_delivery and not l.display_type)"/>
                            <t t-set="first_line" t-value="prod_lines[0] if prod_lines else None"/>
                            <div class="card-body bg-light border-bottom py-3">
                                <a t-attf-href="/my/orders/#{order.id}" class="text-decoration-none text-dark">
                                    <t t-if="first_line">
                                        <div class="d-flex gap-3">
                                            <div class="flex-shrink-0">
                                                <img t-if="first_line.product_id.image_128" t-attf-src="data:image/png;base64,#{first_line.product_id.image_128}" class="rounded border bg-white" style="width: 80px; height: 80px; object-fit: cover;"/>
                                                <div t-else="" class="rounded border bg-white d-flex justify-content-center align-items-center" style="width: 80px; height: 80px;">
                                                    <i class="fa fa-image text-muted fa-2x"></i>
                                                </div>
                                            </div>
                                            <div class="flex-grow-1 d-flex flex-column justify-content-between">
                                                <div class="d-flex justify-content-between">
                                                    <h6 class="mb-1 text-truncate" style="max-width: 60%; font-size: 0.95rem;">
                                                        <t t-esc="first_line.name"/>
                                                    </h6>
                                                    <div class="text-end">
                                                        <span class="fw-bold">฿                                                            <t t-esc="'{0:,.2f}'.format(first_line.price_unit)"/>
                                                        </span>
                                                    </div>
                                                </div>
                                                <div class="d-flex justify-content-between align-items-end text-muted small">
                                                    <span t-if="first_line.product_id.product_template_attribute_value_ids">
                                                        <t t-esc="', '.join(first_line.product_id.product_template_attribute_value_ids.mapped('name'))"/>
                                                    </span>
                                                    <span t-else=""></span>
                                                    <span>x<t t-esc="int(first_line.product_uom_qty)"/>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                </a>
                            </div>

                            <!-- Card Footer -->
                            <div class="card-footer bg-white border-top-0 pt-3 pb-3">
                                <div class="d-flex justify-content-end align-items-center mb-3" style="font-size: 0.95rem;">
                                    <span class="text-dark me-2">สินค้ารวม <t t-esc="int(sum(prod_lines.mapped('product_uom_qty')))"/> ชิ้น:</span>
                                    <span class="fs-5 fw-bold" style="color: #dc3545;">฿                                        <t t-esc="'{0:,.2f}'.format(order.amount_total)"/>
                                    </span>
                                </div>
                                <div class="d-flex justify-content-end gap-2">
                                    <a t-attf-href="/my/orders/#{order.id}" class="btn btn-outline-secondary bg-white text-dark" style="border-radius: 4px; border-color: #ddd; font-size: 0.9rem;">ดูรายละเอียด</a>

                                    <t t-if="order.delivery_status == 'full' and not order.customer_received">
                                        <form t-attf-action="/my/orders/receive/#{order.id}" method="post" style="margin:0;">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <button type="submit" class="btn text-white" style="background: #dc3545; border-radius: 4px; font-size: 0.9rem;">ฉันได้ตรวจสอบและยอมรับสินค้า</button>
                                        </form>
                                    </t>
                                    <t t-elif="order.customer_received">
                                        <!-- Optionally link to shop or repurchase logic -->
                                        <a href="/shop" class="btn text-white" style="background: #dc3545; border-radius: 4px; font-size: 0.9rem;">ซื้ออีกครั้ง</a>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>

                <style>
                    .ra-order-list .card {
                        transition: transform 0.2s ease-in-out;
                    }
                    .ra-order-list .card:hover {
                        transform: translateY(-2px);
                        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
                    }
                    .ra-order-tabs .nav-link {
                        color: #555;
                        border-bottom: 2px solid transparent !important;
                        border-radius: 0;
                    }
                    .ra-order-tabs .nav-link.active {
                        color: #dc3545 !important;
                        border-bottom: 2px solid #dc3545 !important;
                        font-weight: 600;
                    }
                </style>
            </t>
        </xpath>
    </template>


    <!-- ═══════════════════════════════════════════════════════════
         OUT OF STOCK RIBBON INJECTION
         ═══════════════════════════════════════════════════════════ -->
    <template id="products_item_out_of_stock_ribbon" inherit_id="website_sale.products_item" name="Out of Stock Ribbon">
        <xpath expr="//t[@t-if='show_ribbons']" position="before">
            <t t-if="product.is_storable and product.sudo().qty_available &lt;= 0">
                <div class="ra-out-of-stock-ribbon">
                    <span>หมดชั่วคราว</span>
                </div>
            </t>
            <t t-elif="product.is_storable and product.sudo().qty_available &gt; 0 and product.sudo().qty_available &lt;= (product.available_threshold or 5)">
                <div class="ra-low-stock-ribbon">
                    <span>ใกล้หมด</span>
                </div>
            </t>
            <!-- ⚡ Flash Sale Badge -->
            <t t-set="active_flash_sale" t-value="product.env['warehousepart.flash.sale'].sudo().search([('active', '=', True)], limit=1)"/>
            <t t-if="active_flash_sale and active_flash_sale.tag_id">
                <t t-if="any(tag.id == active_flash_sale.tag_id.id for tag in product.sudo().product_tag_ids)">
                    <div class="ra-flash-sale-badge">
                        <span>⚡ Flash Sale -<t t-esc="int(active_flash_sale.discount_percent)"/>%</span>
                    </div>
                </t>
            </t>
        </xpath>
    </template>

    <!-- ═══════════════════════════════════════════════════════════
         UNIFIED SHOP SORT & FILTER BUTTON GROUP
         ═══════════════════════════════════════════════════════════ -->
    <template id="products_sort_filter_unified" inherit_id="website_sale.products" name="Unified Sort &amp; Filter Button Group">
        <!-- Target the sort dropdown and filter button and wrap them in a btn-group -->
        <xpath expr="//t[@t-if=&quot;is_view_active('website_sale.sort')&quot;]" position="replace">
            <div class="btn-group ra-unified-toolbar shadow-sm">
                <t t-if="is_view_active('website_sale.sort')" t-call="website_sale.sort"/>
                <button
                    t-if="wsale_has_filters_btn"
                    t-attf-class="btn btn-{{navClass}} position-relative {{not wsale_has_filters_btn_lg and 'd-lg-none'}} text-nowrap"
                    title="Filters"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#o_wsale_offcanvas"
                >
                    <i class="oi oi-settings-adjust" role="img"/>
                    <small class="ms-1 d-none d-md-inline-block">Filters</small>
                    <span
                        t-if="isFilteringByPrice or attrib_set or tags"
                        t-attf-class="position-absolute top-0 start-100 translate-middle border border-{{navClass}} rounded-circle bg-danger p-1"
                    >
                        <span class="visually-hidden">filters active</span>
                    </span>
                </button>
            </div>
        </xpath>
        <!-- Deactivate or delete the original standalone filter button so it doesn't duplicate! -->
        <xpath expr="//button[@t-if='wsale_has_filters_btn']" position="replace">
            <!-- Standalone button removed because it is now merged inside the btn-group above -->
        </xpath>
    </template>

    <!-- ═══════════════════════════════════════════════════════════
         PRODUCT DETAIL PAGE — FLASH SALE BANNER INJECTION
         ═══════════════════════════════════════════════════════════ -->
    <template id="product_flash_sale_banner" inherit_id="website_sale.product" name="Product Flash Sale Banner">
        <xpath expr="//div[@id='product_details']/*[1]" position="before">
            <t t-set="active_flash_sale" t-value="product.env['warehousepart.flash.sale'].sudo().search([('active', '=', True)], limit=1)"/>
            <t t-if="active_flash_sale and active_flash_sale.tag_id">
                <t t-if="any(tag.id == active_flash_sale.tag_id.id for tag in product.sudo().product_tag_ids)">
                    <div class="ra-flash-detail-banner mb-4 p-3 rounded d-flex align-items-center justify-content-between" style="background: linear-gradient(135deg, rgba(230,57,70,0.15), rgba(255,107,53,0.15)); border: 1px solid rgba(230, 57, 70, 0.3); box-shadow: 0 4px 15px rgba(230, 57, 70, 0.1);">
                        <div class="d-flex align-items-center gap-3">
                            <span style="font-size: 1.5rem;">⚡</span>
                            <div>
                                <h6 class="mb-0 text-white fw-bold" style="letter-spacing: 0.5px; font-size: 0.95rem;">แคมเปญ FLASH SALE กำลังดำเนินอยู่!</h6>
                                <p class="mb-0 fw-bold" style="font-size: 0.8rem; color: #ff8b8b;">สินค้านี้ได้รับส่วนลดพิเศษ <t t-esc="int(active_flash_sale.discount_percent)"/>% ทันที</p>
                            </div>
                        </div>
                        <span class="badge p-2 text-white fw-bold" style="background: #e63946; font-size: 0.85rem; border-radius: 4px; box-shadow: 0 2px 8px rgba(230,57,70,0.4);">
                            ลด <t t-esc="int(active_flash_sale.discount_percent)"/>%
                        </span>
                    </div>
                </t>
            </t>
        </xpath>
    </template>
</odoo>


