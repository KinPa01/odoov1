<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Override the default homepage -->
    <template id="ran_ahlai_homepage" inherit_id="website.homepage" name="Ran Ahlai Homepage">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure oe_empty wh-wrap">

                <!-- Hero Section -->
                <section class="wh-hero">
                    <div class="wh-hero-overlay"></div>
                    <div class="container wh-hero-content">
                        <div class="row justify-content-center">
                            <div class="col-lg-8">
                                <span class="wh-badge">ศูนย์รวมอะไหล่มอเตอร์ไซค์</span>

                                <h1 class="wh-hero-title">
                                    อะไหล่แท้ ราคาดี <span class="wh-hero-accent">ส่งทั่วไทย</span>
                                </h1>

                                <p class="wh-hero-desc">
                                    อะไหล่แท้คุณภาพสูง คัดสรรอย่างพิถีพิถันเพื่อรถคันโปรดของคุณ พร้อมบริการจัดส่งทั่วประเทศอย่างรวดเร็ว
                                </p>

                                <div class="wh-hero-buttons">
                                    <a href="/shop" class="btn wh-btn-primary">เริ่มค้นหาอะไหล่</a>
                                    <a href="/shop" class="btn wh-btn-secondary">ดูหมวดหมู่ทั้งหมด</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Features Section -->
                <section class="wh-features">
                    <div class="container">
                        <div class="row text-center">
                            <div class="col-lg-3 col-md-6 mb-5 mb-lg-0">
                                <div class="wh-feature-item">
                                    <div class="wh-feature-icon">✦</div>
                                    <h5 class="wh-feature-title">อะไหล่แท้ 100%</h5>
                                    <p class="wh-feature-desc">รับประกันคุณภาพทุกชิ้น ส่งตรงจากผู้ผลิตมาตรฐาน OEM</p>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-6 mb-5 mb-lg-0">
                                <div class="wh-feature-item">
                                    <div class="wh-feature-icon">✺</div>
                                    <h5 class="wh-feature-title">ส่งรวดเร็วทันใจ</h5>
                                    <p class="wh-feature-desc">จัดส่งพัสดุทุกวันทำการ มั่นใจได้ว่าของถึงมือคุณใน 1-3 วัน</p>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-6 mb-5 mb-md-0">
                                <div class="wh-feature-item">
                                    <div class="wh-feature-icon">✧</div>
                                    <h5 class="wh-feature-title">ราคาเป็นมิตร</h5>
                                    <p class="wh-feature-desc">นำเข้าและจัดจำหน่ายโดยตรง ไม่ผ่านคนกลาง ได้ราคาที่ดีที่สุด</p>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-6">
                                <div class="wh-feature-item">
                                    <div class="wh-feature-icon">❂</div>
                                    <h5 class="wh-feature-title">ดูแลทุกขั้นตอน</h5>
                                    <p class="wh-feature-desc">มีทีมงานผู้เชี่ยวชาญพร้อมให้คำปรึกษา แนะนำอะไหล่ที่ตรงรุ่น</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Category Section -->
                <section class="wh-category-bar">
                    <div class="container">
                        <div class="d-flex justify-content-between align-items-center">
                            <h3 class="wh-category-title">ค้นหาตามหมวดหมู่</h3>
                            <a href="/shop" class="wh-category-link">ดูสินค้าทั้งหมด →</a>
                        </div>
                    </div>
                </section>
            </div>
        </xpath>
    </template>

    <!-- Enable Categories Sidebar on Shop Page -->
    <record id="website_sale.products_categories" model="ir.ui.view">
        <field name="active" eval="True"/>
    </record>

</odoo>
