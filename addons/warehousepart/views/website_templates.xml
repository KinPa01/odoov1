<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Override the default homepage -->
    <template id="ran_ahlai_homepage" inherit_id="website.homepage" name="Ran Ahlai Homepage">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure oe_empty">
                <!-- Hero Section -->
                <section class="warehouse-hero" style="background: linear-gradient(to right, #580f0f, #15111d); padding: 80px 0; min-height: 60vh; display: flex; align-items: center; color: white;">
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-8">
                                <span class="badge" style="background-color: #dca816; color: #111; padding: 5px 15px; border-radius: 20px; font-weight: bold; margin-bottom: 20px; font-size: 0.85rem;">อะไหล่มอเตอร์ไซค์</span>
                                <h1 style="font-size: 3.5rem; font-weight: 800; line-height: 1.2; margin-bottom: 20px;">
                                    อะไหล่แท้ ราคาดี<br/>ส่งทั่วไทย
                                </h1>
                                <p style="font-size: 1.2rem; color: #e5e7eb; margin-bottom: 30px;">
                                    คัดสรรอะไหล่คุณภาพสูงสำหรับทุกรุ่น ทุกยี่ห้อ
                                </p>
                                <div class="d-flex mb-5" style="gap: 15px;">
                                    <a href="/shop" class="btn" style="background-color: #8b1515; color: white; padding: 12px 25px; border-radius: 6px; font-weight: bold; border: 1px solid #8b1515; font-size: 0.95rem;">
                                        <i class="fa fa-shopping-cart mr-2"></i> เลือกซื้อสินค้า
                                    </a>
                                    <a href="/shop" class="btn" style="background-color: transparent; color: white; padding: 12px 25px; border-radius: 6px; font-weight: bold; border: 1px solid rgba(255,255,255,0.5); font-size: 0.95rem;">
                                        ดูหมวดหมู่
                                    </a>
                                </div>
                                
                                <div class="d-flex mt-4" style="gap: 40px; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 25px; display: inline-flex !important;">
                                    <div>
                                        <h3 style="font-weight: 800; margin-bottom: 0;">8+</h3>
                                        <p style="font-size: 0.8rem; color: #9ca3af; margin-bottom: 0;">รายการ</p>
                                    </div>
                                    <div style="border-left: 1px solid rgba(255,255,255,0.2); padding-left: 40px;">
                                        <h3 style="font-weight: 800; margin-bottom: 0;">12</h3>
                                        <p style="font-size: 0.8rem; color: #9ca3af; margin-bottom: 0;">หมวดหมู่</p>
                                    </div>
                                    <div style="border-left: 1px solid rgba(255,255,255,0.2); padding-left: 40px;">
                                        <h3 style="font-weight: 800; margin-bottom: 0;">6</h3>
                                        <p style="font-size: 0.8rem; color: #9ca3af; margin-bottom: 0;">ยี่ห้อ</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                
                <!-- Features Section -->
                <section class="warehouse-features pb64" style="background-color: #ffffff; margin-top: -30px; position: relative; z-index: 10;">
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-3 col-md-6 mb-4">
                                <div class="card h-100 text-center" style="border: 1px solid #eaeaea; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); padding: 30px 15px; background: white;">
                                    <div style="margin-bottom: 15px;">
                                        <div style="width: 45px; height: 45px; background-color: #4ade80; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; color: white;">
                                            <i class="fa fa-check fa-lg"></i>
                                        </div>
                                    </div>
                                    <h5 style="color: #8b1515; font-size: 0.95rem; font-weight: 700;">อะไหล่แท้ 100%</h5>
                                    <p style="color: #6b7280; font-size: 0.8rem; margin-bottom: 0;">รับประกันคุณภาพทุกชิ้น มาตรฐาน OEM</p>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-6 mb-4">
                                <div class="card h-100 text-center" style="border: 1px solid #eaeaea; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); padding: 30px 15px; background: white;">
                                    <div style="margin-bottom: 15px;">
                                        <div style="font-size: 32px; line-height: 1;">🚚</div>
                                    </div>
                                    <h5 style="color: #8b1515; font-size: 0.95rem; font-weight: 700;">ส่งเร็วทั่วไทย</h5>
                                    <p style="color: #6b7280; font-size: 0.8rem; margin-bottom: 0;">จัดส่งภายใน 1-3 วันทำการ</p>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-6 mb-4">
                                <div class="card h-100 text-center" style="border: 1px solid #eaeaea; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); padding: 30px 15px; background: white;">
                                    <div style="margin-bottom: 15px;">
                                        <div style="font-size: 32px; line-height: 1;">💰</div>
                                    </div>
                                    <h5 style="color: #8b1515; font-size: 0.95rem; font-weight: 700;">ราคาแข่งขัน</h5>
                                    <p style="color: #6b7280; font-size: 0.8rem; margin-bottom: 0;">ตรงจากผู้นำเข้า ไม่ผ่านคนกลาง</p>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-6 mb-4">
                                <div class="card h-100 text-center" style="border: 1px solid #eaeaea; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); padding: 30px 15px; background: white;">
                                    <div style="margin-bottom: 15px;">
                                        <div style="font-size: 32px; line-height: 1;">📞</div>
                                    </div>
                                    <h5 style="color: #8b1515; font-size: 0.95rem; font-weight: 700;">บริการหลังการขาย</h5>
                                    <p style="color: #6b7280; font-size: 0.8rem; margin-bottom: 0;">ทีมงานพร้อมให้คำปรึกษา</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                
                <!-- Category Section -->
                <section class="pt32 pb64" style="background-color: #f9fafb;">
                    <div class="container">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h3 style="font-weight: 700; font-size: 1.5rem;">หมวดหมู่สินค้า</h3>
                            <a href="/shop" style="color: #4b5563; font-size: 0.9rem;">เลือกประเภทอะไหล่ที่คุณต้องการ</a>
                        </div>
                    </div>
                </section>
            </div>
        </xpath>
    </template>

    <!-- Enable Categories Sidebar on Shop Page -->
    <record id="website_sale.products_categories" model="ir.ui.view">
        <field name="active" eval="True"/>
    </record>

</odoo>
